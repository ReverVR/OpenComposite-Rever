@@ -98,6 +99,138 @@ VkCompositor::~VkCompositor()
 {
 	// destroying command pool also frees command buffers
 	vkDestroyCommandPool(appDevice, appCommandPool, nullptr);
+	if (rawBuffer)
+		vkDestroyBuffer(appDevice, rawBuffer, nullptr);
+	if (rawMemory)
