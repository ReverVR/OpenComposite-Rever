+// Rever VR: IVRInput_003's VRActiveActionSet_t is 24 bytes (no unPadding / nPriority, added in IVRInput_004): copied
+// into the current struct with priority 0 (Fallout: New Vegas, "sizeof(*pSets) == unSizeOfVRSelectedActionSet_t")
+static std::vector<OOVR_VRActiveActionSet_t> rever_sets_from_003(const vr::IVRInput_003::VRActiveActionSet_t* pSets, uint32_t unSetCount)
+{
+	std::vector<OOVR_VRActiveActionSet_t> sets(unSetCount);
+	for (uint32_t i = 0; i < unSetCount; i++) {
+		sets[i] = {};
+		sets[i].ulActionSet = pSets[i].ulActionSet;
+		sets[i].ulRestrictedToDevice = pSets[i].ulRestrictedToDevice;
+		sets[i].ulSecondaryActionSet = pSets[i].ulSecondaryActionSet;
+	}
+	return sets;
+}
+
+vr::EVRInputError CVRInput_003::UpdateActionState(vr::IVRInput_003::VRActiveActionSet_t* pSets, uint32_t unSizeOfVRSelectedActionSet_t, uint32_t unSetCount)
+{
+	if (unSizeOfVRSelectedActionSet_t != sizeof(vr::IVRInput_003::VRActiveActionSet_t))
+		return vr::VRInputError_InvalidParam;
+	std::vector<OOVR_VRActiveActionSet_t> sets = rever_sets_from_003(pSets, unSetCount);
+	return base->UpdateActionState(sets.data(), sizeof(OOVR_VRActiveActionSet_t), unSetCount);
+}
