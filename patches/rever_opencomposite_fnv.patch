+vr::EVRInputError CVRInput_003::ShowBindingsForActionSet(vr::IVRInput_003::VRActiveActionSet_t* pSets, uint32_t unSizeOfVRSelectedActionSet_t, uint32_t unSetCount, vr::IVRInput_003::VRInputValueHandle_t originToHighlight)
+{
