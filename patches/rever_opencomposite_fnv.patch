+void XrBackend::ReverOverlayOnlyFrame()
+{
+	PumpEvents();
+	if (!sessionActive || !usingApplicationGraphicsAPI || renderingFrame || xrFrameOpen)
+		return;
+	if (std::chrono::steady_clock::now() - reverLastWait < std::chrono::milliseconds(200))
+		return;
+
+	static int frames = 0;
+	if (++frames == 1 || frames % 1000 == 0)
+		OOVR_LOGF("Rever VR: overlay-only frames while the game is outside its frame loop (%d so far)", frames);
+
+	XrFrameWaitInfo waitInfo{ XR_TYPE_FRAME_WAIT_INFO };
+	XrFrameState state{ XR_TYPE_FRAME_STATE };
+	{
+		auto lock = xr_session.lock_shared();
+		OOVR_FAILED_XR_ABORT(xrWaitFrame(xr_session.get(), &waitInfo, &state));
+		xr_gbl->nextPredictedFrameTime = state.predictedDisplayTime;
+		XrFrameBeginInfo beginInfo{ XR_TYPE_FRAME_BEGIN_INFO };
+		OOVR_FAILED_XR_ABORT(xrBeginFrame(xr_session.get(), &beginInfo));
+	}
+
+	XrCompositionLayerBaseHeader const* const* headers = nullptr;
+	int layer_count = 0;
+	if (BaseOverlay* overlay = GetUnsafeBaseOverlay())
+		layer_count = overlay->_BuildLayers(nullptr, headers);
+
+	XrFrameEndInfo info{ XR_TYPE_FRAME_END_INFO };
+	info.environmentBlendMode = XR_ENVIRONMENT_BLEND_MODE_OPAQUE;
+	info.displayTime = xr_gbl->nextPredictedFrameTime;
+	info.layers = headers;
+	info.layerCount = layer_count;
+	OOVR_FAILED_XR_SOFT_ABORT(xrEndFrame(xr_session.get(), &info));
+}
