+// --- Alyx's numbers ------------------------------------------------------------------------------------------------
+constexpr float kP22 = -0.950057f, kP23 = -0.0374928f; // its Z row (KB ALX-002, the headset's probe)
+constexpr double kNearRef = double(kP23) / double(kP22); // the nearest view distance the buffer holds (raw depth 0)
