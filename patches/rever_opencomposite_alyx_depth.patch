+// Rever VR (GPL-3.0, Rever's OpenComposite), 2026-11-19 - Half-Life: Alyx's own depth for Rever's DLSS / FSR (KB ALX-002,
+// step 2; user: "si"). See ReverGameDepth.cpp.
+#pragma once
+
+#include <cstdint>
+
+struct ID3D11Texture2D;
+
+namespace rever_game_depth {
+
+struct Pose {
+	float orientation[4] = { 0, 0, 0, 1 }; // x, y, z, w
+	float position[3] = { 0, 0, 0 }; // metres
+};
+
+// One eye's submit as the producer takes it (ReverGameDepthSubmit fills it from OpenVR's / OpenComposite's own data;
+// the desk test fills it by hand).
+struct EyeInput {
