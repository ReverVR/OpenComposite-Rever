+
+int main(int argc, char** argv)
+{
+	if (argc >= 7 && std::strcmp(argv[1], "--reader") == 0) { // the second process (StartReader)
+		FILE* answer = nullptr;
+		if (freopen_s(&answer, argv[4], "w", stdout) != 0)
+			return 5;
+		return ReaderProcess(uint32_t(std::atoi(argv[2])), uint32_t(std::atoi(argv[3])), std::atoi(argv[5]),
+		    std::strtoul(argv[6], nullptr, 10));
+	}
+	setvbuf(stdout, nullptr, _IONBF, 0);
+	rever_game_depth::TestSetLog(Sink);
+	rever_game_depth::TestSetNames(kBlockName, kTexturePrefix);
+	char text[512];
+
+	// --- the switch: off unless 1 -------------------------------------------------------------------------------------
+	SetEnvironmentVariableA("REVER_ALYX_GAME_DEPTH", "0");
+	rever_game_depth::TestReset();
+	Gpu gpu;
+	if (!MakeGpu(gpu)) {
+		std::printf("[FAIL] no D3D11 hardware device\n");
+		return 2;
+	}
+	const Layout layout = MakeLayout(532, 1507, 753); // Alyx's 2661 / 7534 x 3767, a fifth of it
+	DepthTarget target = MakeDepth(gpu, layout.texW, layout.texH, 1);
+	Head headA{ { 0, 0, 0, 1 }, { 0.1, 1.7 - 1.7, 0.2 } };
+	Eye a[2] = { MakeEye(0, headA), MakeEye(1, headA) };
+	DrawDepth(gpu, target, layout, a);
+	uint64_t now = 100000;
+	const bool offProduced = rever_game_depth::ProduceEye(0, Input(target, layout, a[0], 0, now));
+	HANDLE stray = OpenFileMappingW(FILE_MAP_READ, FALSE, kBlockName);
+	Check(!offProduced && !stray && Logged("off (REVER_ALYX_GAME_DEPTH=0)"), "REVER_ALYX_GAME_DEPTH=0: no producer, no block");
+	if (stray)
+		CloseHandle(stray);
+	SetEnvironmentVariableA("REVER_ALYX_GAME_DEPTH", nullptr);
+	rever_game_depth::TestReset();
+	Check(!rever_game_depth::ProduceEye(0, Input(target, layout, a[0], 0, now)) && Logged("off (REVER_ALYX_GAME_DEPTH=unset)"),
+	    "REVER_ALYX_GAME_DEPTH unset: no producer");
+	SetEnvironmentVariableA("REVER_ALYX_GAME_DEPTH", "1");
+	rever_game_depth::TestReset();
+
+	// --- the bridge host's case (SSW's and the stabiliser's routes): the only reader is another process, its own device ----
+	// (Alyx's own loader never runs Rever's layer then: REVER_XR_NR_DISABLE=1). It reads four frames as they are handed:
+	// the first a cut (zero motion), then a head turn each frame; its depth against the CPU's scene, its motion against the
+	// CPU's reprojection (the mean over the eye); the producer takes key 0 back from it every frame.
+	{
+		constexpr int kFrames = 4;
+		ReaderChild child;
+		const bool started = StartReader(child, uint32_t(layout.width), uint32_t(layout.height), kFrames);
+		const bool ready = started && WaitFor(child, child.ready, 60000); // its start can take seconds (a new exe scanned)
+		double expected[kFrames][2][2] = {};
+		bool handed = ready;
+		Eye before[2] = { a[0], a[1] };
+		for (int frame = 0; frame < kFrames && handed; ++frame) {
+			Head head{ {}, { 0.1 + 0.01 * frame, -0.005 * frame, 0.2 - 0.01 * frame } };
+			QuatFromYawPitch(2.0 * frame, -0.7 * frame, head.q);
+			Eye eyes[2] = { MakeEye(0, head), MakeEye(1, head) };
+			DrawDepth(gpu, target, layout, eyes);
+			now += 11;
+			for (int e = 0; e < 2; ++e) {
+				handed = rever_game_depth::ProduceEye(e, Input(target, layout, eyes[e], e, now)) && handed;
+				float P[4][4];
+				Projection(before[e], P);
+				const Expected x = Reproject(eyes[e], before[e], P, layout.width, layout.height, frame > 0);
+				expected[frame][e][0] = Sum(x.depth);
+				expected[frame][e][1] = frame > 0 ? MeanAbsMotion(x.motion) : 0.0;
+				before[e] = eyes[e];
+			}
+			handed = WaitFor(child, child.taken, 20000) && handed;
+		}
+		DWORD exitCode = 0;
+		const std::string out = FinishReader(child, exitCode);
+		int lines = 0, good = 0;
+		double worstDepth = 0, worstMotion = 0;
+		for (size_t at = out.find("READER frame"); at != std::string::npos; at = out.find("READER frame", at + 1)) {
+			int frame = -1;
+			unsigned eye = 9;
+			double depthSum = 0, motionMean = 0;
+			if (std::sscanf(out.c_str() + at, "READER frame %d eye %u depth %lf motion %lf", &frame, &eye, &depthSum, &motionMean) != 4 ||
+			    frame < 0 || frame >= kFrames || eye > 1)
+				continue;
+			++lines;
+			const double ed = expected[frame][eye][0], em = expected[frame][eye][1];
+			const double relDepth = std::fabs(depthSum - ed) / (ed > 0 ? ed : 1.0);
+			const double motionErr = std::fabs(motionMean - em);
+			worstDepth = relDepth > worstDepth ? relDepth : worstDepth;
+			worstMotion = motionErr > worstMotion ? motionErr : worstMotion;
+			if (relDepth < 2e-3 && motionErr <= 0.05 + 0.02 * em && (frame > 0 || motionMean == 0.0))
+				++good;
+		}
+		snprintf(text, sizeof(text), "started %d, ready %d, all handed and taken %d, exit %lu, %d of %d eye-frames read and right "
+		    "(depth sum rel err max %.1e, mean |motion| err max %.4f px; frame 3 mean |motion| %.2f px)",
+		    int(started), int(ready), int(handed), exitCode, good, lines, worstDepth, worstMotion, expected[kFrames - 1][0][1]);
+		if (good != 2 * kFrames)
+			std::printf("  reader process said: %s", out.c_str());
+		Check(started && ready && handed && exitCode == 0 && lines == 2 * kFrames && good == 2 * kFrames,
+		    "another process, its own device, frame after frame: takes key 1, reads the depth and the camera's motion, gives key 0 "
+		    "back, and the producer takes it again",
+		    text);
+		rever_game_depth::TestReset(); // the in-process layer's checks below start from nothing
+		DrawDepth(gpu, target, layout, a); // frame A's scene again
+	}
+
+	// --- frame A: the first (a cut: zero motion) ----------------------------------------------------------------------
+	LayerReader layer; // the layer in Alyx's own process: the game's device
+	layer.device1 = gpu.device1;
+	layer.ctx = gpu.ctx;
+	Check(layer.Take(0, layout.width, layout.height, 2, nullptr, nullptr) == kNoBlock, "before the first frame there is no block");
+	bool ok0 = rever_game_depth::ProduceEye(0, Input(target, layout, a[0], 0, now));
+	bool ok1 = rever_game_depth::ProduceEye(1, Input(target, layout, a[1], 1, now));
+	Check(ok0 && ok1, "frame A produced for both eyes");
+	{
+		HANDLE m = OpenFileMappingW(FILE_MAP_READ, FALSE, kBlockName);
+		const SrInputsBlock* b = m ? static_cast<const SrInputsBlock*>(MapViewOfFile(m, FILE_MAP_READ, 0, 0, sizeof(SrInputsBlock))) : nullptr;
+		snprintf(text, sizeof(text), "magic %08x version %u pid %u (self %lu) %ux%u (eye rect %dx%d) flags %u generation %ld seq %ld/%ld phase %u/%u",
+		    b ? b->magic : 0, b ? b->version : 0, b ? b->pid : 0, GetCurrentProcessId(), b ? b->width : 0, b ? b->height : 0,
+		    layout.width, layout.height, b ? b->flags : 0, b ? b->generation : 0, b ? b->eyes[0].seq : 0, b ? b->eyes[1].seq : 0,
+		    b ? b->eyes[0].phase : 9, b ? b->eyes[1].phase : 9);
+		Check(b && b->magic == kSrInputsMagic && b->version == 1 && b->pid == GetCurrentProcessId() && b->width == uint32_t(layout.width)
+		        && b->height == uint32_t(layout.height) && b->flags == 1 && b->generation >= 1 && b->eyes[0].seq == 1
+		        && b->eyes[1].seq == 1 && b->eyes[0].phase == 0 && b->eyes[1].phase == 0,
+		    "the block as rever_xr_nr reads it", text);
+		if (b)
+			UnmapViewOfFile(b);
+		if (m)
+			CloseHandle(m);
+	}
+	Check(layer.Take(0, layout.width + 1, layout.height, 2, nullptr, nullptr) == kSizeRefused,
+	    "another eye size is refused, as the layer refuses it");
+	std::vector<float> depth, motion;
+	for (int e = 0; e < 2; ++e) {
+		const TakeResult r = layer.Take(uint32_t(e), layout.width, layout.height, 2, &depth, &motion);
+		float P[4][4];
+		Projection(a[e], P);
+		const Expected x = Reproject(a[e], a[e], P, layout.width, layout.height, false);
+		const Compare c = CompareEye(x, depth, motion, true);
+		snprintf(text, sizeof(text), "eye %d: taken %d, inverted %d, depth max rel err %.2e, motion max %.4f px over %llu px, sky %llu px "
+		    "(non-zero depth %llu), bad %llu",
+		    e, int(r == kTaken), int(layer.inverted), c.depthMaxRel, c.motionMax, (unsigned long long)c.compared,
+		    (unsigned long long)c.skyPixels, (unsigned long long)c.skyNonZeroDepth, (unsigned long long)c.bad);
+		Check(r == kTaken && layer.inverted && c.compared > 100000 && c.bad == 0 && c.skyPixels > 1000 && c.skyNonZeroDepth == 0
+		        && MaxAbs(motion) == 0.0,
+		    "frame A (the first: a cut): the inverted depth matches the scene, the sky is 0, the motion is zero", text);
+	}
+	Check(layer.Take(0, layout.width, layout.height, 2, nullptr, nullptr) == kNothingNew, "the same frame is not taken twice (seq)");
+
+	// --- frame B: a head turn over a static scene --------------------------------------------------------------------
+	// the game's own compute / output-merger state, to be given back as it was (and its depth bound for writing)
+	ID3DBlob* dummyCode = Compile("RWTexture2D<float> o : register(u0); [numthreads(1,1,1)] void CS(uint3 i : SV_DispatchThreadID) { o[i.xy] = 1; }",
+	    "CS", "cs_5_0");
+	ID3D11ComputeShader* gameCs = nullptr;
+	gpu.device->CreateComputeShader(dummyCode->GetBufferPointer(), dummyCode->GetBufferSize(), nullptr, &gameCs);
+	dummyCode->Release();
+	D3D11_TEXTURE2D_DESC gd{};
+	gd.Width = gd.Height = 16;
+	gd.MipLevels = gd.ArraySize = 1;
+	gd.Format = DXGI_FORMAT_R32_FLOAT;
+	gd.SampleDesc.Count = 1;
+	gd.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS;
+	ID3D11Texture2D* gameTex = nullptr;
+	ID3D11Texture2D* gameTex2 = nullptr;
+	gpu.device->CreateTexture2D(&gd, nullptr, &gameTex);
+	gpu.device->CreateTexture2D(&gd, nullptr, &gameTex2);
+	ID3D11ShaderResourceView* gameSrv = nullptr;
+	ID3D11UnorderedAccessView* gameUav = nullptr;
+	gpu.device->CreateShaderResourceView(gameTex, nullptr, &gameSrv);
+	gpu.device->CreateUnorderedAccessView(gameTex2, nullptr, &gameUav);
+	gd.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+	gd.Width = layout.texW;
+	gd.Height = layout.texH;
+	gd.BindFlags = D3D11_BIND_RENDER_TARGET;
+	ID3D11Texture2D* gameColour = nullptr;
+	ID3D11RenderTargetView* gameRtv = nullptr;
+	gpu.device->CreateTexture2D(&gd, nullptr, &gameColour);
+	gpu.device->CreateRenderTargetView(gameColour, nullptr, &gameRtv);
+
+	Head headB{ {}, { 0.13, -0.01, 0.18 } };
+	QuatFromYawPitch(4.0, -1.5, headB.q);
+	Eye b[2] = { MakeEye(0, headB), MakeEye(1, headB) };
+	DrawDepth(gpu, target, layout, b);
+	now += 11;
+	gpu.ctx->CSSetShader(gameCs, nullptr, 0);
+	gpu.ctx->CSSetShaderResources(0, 1, &gameSrv);
+	gpu.ctx->CSSetUnorderedAccessViews(0, 1, &gameUav, nullptr);
+	gpu.ctx->CSSetConstantBuffers(0, 1, &gpu.cb);
+	gpu.ctx->OMSetRenderTargets(1, &gameRtv, target.dsv); // the game's depth still bound for writing at its submit
+	ok0 = rever_game_depth::ProduceEye(0, Input(target, layout, b[0], 0, now));
+	{
+		ID3D11ComputeShader* cs = nullptr;
+		ID3D11ShaderResourceView* srv = nullptr;
+		ID3D11UnorderedAccessView* uav = nullptr;
+		ID3D11Buffer* cb = nullptr;
+		ID3D11RenderTargetView* rtv = nullptr;
+		ID3D11DepthStencilView* dsv = nullptr;
+		gpu.ctx->CSGetShader(&cs, nullptr, nullptr);
+		gpu.ctx->CSGetShaderResources(0, 1, &srv);
+		gpu.ctx->CSGetUnorderedAccessViews(0, 1, &uav);
+		gpu.ctx->CSGetConstantBuffers(0, 1, &cb);
+		gpu.ctx->OMGetRenderTargets(1, &rtv, &dsv);
+		Check(cs == gameCs && srv == gameSrv && uav == gameUav && cb == gpu.cb && rtv == gameRtv && dsv == target.dsv,
+		    "the game's compute shader, views, constant buffer and render / depth targets given back as they were");
+		SafeRelease(cs);
+		SafeRelease(srv);
+		SafeRelease(uav);
+		SafeRelease(cb);
+		SafeRelease(rtv);
+		SafeRelease(dsv);
+	}
+	gpu.ctx->OMSetRenderTargets(0, nullptr, nullptr);
+	ID3D11ShaderResourceView* noSrv = nullptr;
+	ID3D11UnorderedAccessView* noUav = nullptr;
+	gpu.ctx->CSSetShaderResources(0, 1, &noSrv);
+	gpu.ctx->CSSetUnorderedAccessViews(0, 1, &noUav, nullptr);
+	gpu.ctx->CSSetShader(nullptr, nullptr, 0);
+	ok1 = rever_game_depth::ProduceEye(1, Input(target, layout, b[1], 1, now));
+	Check(ok0 && ok1, "frame B produced for both eyes");
+	for (int e = 0; e < 2; ++e) {
+		const TakeResult r = layer.Take(uint32_t(e), layout.width, layout.height, 2, &depth, &motion);
+		float Pa[4][4];
+		Projection(a[e], Pa);
+		const Expected x = Reproject(b[e], a[e], Pa, layout.width, layout.height, true);
+		const Compare c = CompareEye(x, depth, motion, false);
+		snprintf(text, sizeof(text), "eye %d: taken %d, motion max err %.4f px, mean err %.4f px (mean motion %.2f px) over %llu px, "
+		    "sky motion max err %.4f px, depth max rel err %.2e, bad %llu",
+		    e, int(r == kTaken), c.motionMax, c.motionMean, MeanAbsMotion(x.motion), (unsigned long long)c.compared, c.skyMotionMax,
+		    c.depthMaxRel, (unsigned long long)c.bad);
+		Check(r == kTaken && c.compared > 100000 && c.bad == 0 && MeanAbsMotion(x.motion) > 5.0,
+		    "frame B (a head turn, a static scene): the vectors match the CPU's reprojection, the sky its rotation", text);
+	}
+
+	// --- cuts: OpenVR's discontinuity, a pose jump, a gap ------------------------------------------------------------
+	const auto zeroMotionFrame = [&](const char* what, const Eye eyes[2], uint64_t at, uint32_t flags) {
+		const uint64_t resetsBefore = rever_game_depth::CurrentStats().resets;
+		const bool p0 = rever_game_depth::ProduceEye(0, Input(target, layout, eyes[0], 0, at, flags));
+		const bool p1 = rever_game_depth::ProduceEye(1, Input(target, layout, eyes[1], 1, at, flags));
+		double worst = 0;
+		bool taken = true;
+		for (int e = 0; e < 2; ++e) {
+			taken = layer.Take(uint32_t(e), layout.width, layout.height, 2, &depth, &motion) == kTaken && taken;
+			worst = MaxAbs(motion) > worst ? MaxAbs(motion) : worst;
+		}
+		const uint64_t resets = rever_game_depth::CurrentStats().resets - resetsBefore;
+		snprintf(text, sizeof(text), "produced %d/%d, taken %d, max |motion| %.4f, resets +%llu", int(p0), int(p1), int(taken), worst,
+		    (unsigned long long)resets);
+		Check(p0 && p1 && taken && worst == 0.0 && resets == 2, what, text);
+	};
+	Head headC = headB;
+	QuatFromYawPitch(6.0, -1.0, headC.q);
+	Eye c[2] = { MakeEye(0, headC), MakeEye(1, headC) };
+	DrawDepth(gpu, target, layout, c);
+	now += 11;
+	zeroMotionFrame("a discontinuity (flag 0x20) is a cut: zero motion", c, now, 0x238);
+	Head headD = headC;
+	headD.position[0] += 1.0; // a metre in one frame: a recentre, tracking lost
+	Eye dEyes[2] = { MakeEye(0, headD), MakeEye(1, headD) };
+	DrawDepth(gpu, target, layout, dEyes);
+	now += 11;
+	zeroMotionFrame("a pose jump is a cut: zero motion", dEyes, now, 0x218);
+	now += 400;
+	zeroMotionFrame("a gap of 400 ms is a cut: zero motion", dEyes, now, 0x218);
+	{ // and the next ordinary frame moves again
+		Head headE = headD;
+		QuatFromYawPitch(8.0, -1.0, headE.q);
+		Eye e2[2] = { MakeEye(0, headE), MakeEye(1, headE) };
+		DrawDepth(gpu, target, layout, e2);
+		now += 11;
+		rever_game_depth::ProduceEye(0, Input(target, layout, e2[0], 0, now));
+		layer.Take(0, layout.width, layout.height, 2, &depth, &motion);
+		float Pd[4][4];
+		Projection(dEyes[0], Pd);
+		const Compare cmp = CompareEye(Reproject(e2[0], dEyes[0], Pd, layout.width, layout.height, true), depth, motion, false);
+		snprintf(text, sizeof(text), "motion max err %.4f px, bad %llu", cmp.motionMax, (unsigned long long)cmp.bad);
+		Check(cmp.bad == 0 && MaxAbs(motion) > 1.0, "after a cut the next frame has its motion again", text);
+		rever_game_depth::ProduceEye(1, Input(target, layout, e2[1], 1, now));
+		layer.Take(1, layout.width, layout.height, 2, nullptr, nullptr);
+		std::memcpy(dEyes, e2, sizeof(e2));
+	}
+
+	// --- a busy key: the frame skipped, never waited for --------------------------------------------------------------
+	{
+		now += 11;
+		rever_game_depth::ProduceEye(0, Input(target, layout, dEyes[0], 0, now)); // written, key 1
+		// the reader takes key 1 and holds it (as the layer does while DLSS reads it)
+		const LONG seqBefore = layer.block->eyes[0].seq;
+		const bool held = layer.depthMutex[0]->AcquireSync(1, 100) == S_OK;
+		const uint64_t busyBefore = rever_game_depth::CurrentStats().busy;
+		LARGE_INTEGER f, t0, t1;
+		QueryPerformanceFrequency(&f);
+		QueryPerformanceCounter(&t0);
+		now += 11;
+		const bool produced = rever_game_depth::ProduceEye(0, Input(target, layout, dEyes[0], 0, now));
+		QueryPerformanceCounter(&t1);
+		const double ms = double(t1.QuadPart - t0.QuadPart) * 1000.0 / double(f.QuadPart);
+		const bool sameSeq = layer.block->eyes[0].seq == seqBefore;
+		if (held)
+			layer.depthMutex[0]->ReleaseSync(0);
+		snprintf(text, sizeof(text), "held %d, produced %d, busy +%llu, seq unchanged %d, the call took %.3f ms", int(held), int(produced),
+		    (unsigned long long)(rever_game_depth::CurrentStats().busy - busyBefore), int(sameSeq), ms);
+		Check(held && !produced && sameSeq && rever_game_depth::CurrentStats().busy == busyBefore + 1 && ms < 5.0,
+		    "a key the reader holds skips the frame at once", text);
+		now += 11;
+		Check(rever_game_depth::ProduceEye(0, Input(target, layout, dEyes[0], 0, now)), "given back, the next frame is produced");
+		layer.Take(0, layout.width, layout.height, 2, nullptr, nullptr);
+	}
+
+	// --- the eyes' sizes differ by a pixel: eye 1 goes without (the block holds one size) ----------------------------
+	{
+		EyeInput odd = Input(target, layout, dEyes[1], 1, now);
+		odd.width -= 1;
+		const uint64_t before = rever_game_depth::CurrentStats().sizeSkips;
+		Check(!rever_game_depth::ProduceEye(1, odd) && rever_game_depth::CurrentStats().sizeSkips == before + 1,
+		    "eye 1 of another size than eye 0 is skipped");
+	}
+
+	// --- a new size (the game's resolution changed): a new generation, the layer reopens, zero motion first ------------
+	{
+		const Layout reduced = MakeLayout(500, 1507, 753);
+		DrawDepth(gpu, target, reduced, dEyes);
+		const long genBefore = rever_game_depth::CurrentStats().generation;
+		now += 11;
+		const bool p0 = rever_game_depth::ProduceEye(0, Input(target, reduced, dEyes[0], 0, now));
+		const bool p1 = rever_game_depth::ProduceEye(1, Input(target, reduced, dEyes[1], 1, now));
+		const TakeResult r0 = layer.Take(0, reduced.width, reduced.height, 2, &depth, &motion);
+		const double m0 = MaxAbs(motion);
+		const TakeResult r1 = layer.Take(1, reduced.width, reduced.height, 2, nullptr, nullptr);
+		const rever_game_depth::Stats s = rever_game_depth::CurrentStats();
+		snprintf(text, sizeof(text), "generation %ld -> %ld, %ux%u (eye rect %dx%d), taken %d/%d, max |motion| %.4f", genBefore, s.generation,
+		    s.width, s.height, reduced.width, reduced.height, int(r0 == kTaken), int(r1 == kTaken), m0);
+		Check(p0 && p1 && s.generation == genBefore + 1 && s.width == uint32_t(reduced.width) && r0 == kTaken && r1 == kTaken && m0 == 0.0,
+		    "a new size: new textures (generation), the layer opens them, the first frame a cut", text);
+		Check(layer.Take(0, layout.width, layout.height, 2, nullptr, nullptr) == kSizeRefused, "the old size is refused afterwards");
+		DrawDepth(gpu, target, layout, dEyes);
+		now += 11;
+		rever_game_depth::ProduceEye(0, Input(target, layout, dEyes[0], 0, now));
+		rever_game_depth::ProduceEye(1, Input(target, layout, dEyes[1], 1, now));
+		layer.Take(0, layout.width, layout.height, 2, nullptr, nullptr);
+		layer.Take(1, layout.width, layout.height, 2, nullptr, nullptr);
+	}
+
+	// --- a multisampled depth (sample 0) -----------------------------------------------------------------------------
+	{
+		DepthTarget ms = MakeDepth(gpu, layout.texW, layout.texH, 4);
+		DrawDepth(gpu, ms, layout, dEyes);
+		now += 11;
+		const bool p = rever_game_depth::ProduceEye(0, Input(ms, layout, dEyes[0], 0, now));
+		const TakeResult r = layer.Take(0, layout.width, layout.height, 2, &depth, &motion);
+		float P[4][4];
+		Projection(dEyes[0], P);
+		const Compare cmp = CompareEye(Reproject(dEyes[0], dEyes[0], P, layout.width, layout.height, true), depth, motion, false);
+		snprintf(text, sizeof(text), "produced %d, taken %d, depth max rel err %.2e, motion max %.4f px (still head), bad %llu", int(p),
+		    int(r == kTaken), cmp.depthMaxRel, cmp.motionMax, (unsigned long long)cmp.bad);
+		Check(p && r == kTaken && cmp.bad == 0, "a 4x MSAA depth is read (its sample 0)", text);
+		rever_game_depth::ProduceEye(1, Input(ms, layout, dEyes[1], 1, now));
+		layer.Take(1, layout.width, layout.height, 2, nullptr, nullptr);
+		SafeRelease(ms.dsv);
+		SafeRelease(ms.texture);
+	}
+
+	// --- the per-second line ------------------------------------------------------------------------------------------
+	now += 1500;
+	rever_game_depth::ProduceEye(0, Input(target, layout, dEyes[0], 0, now));
+	Check(Logged("eyes produced") && Logged("resets"), "the per-second line (eyes produced, skipped, size, resets)");
+	Check(Logged("first handed to Rever's layer"), "the first eye's line (sizes, depth convention, tangents)");
+
+	const rever_game_depth::Stats s = rever_game_depth::CurrentStats();
+	std::printf("stats: produced %llu, busy %llu, size %llu, other %llu, resets %llu, %ux%u generation %ld, broken %d\n",
+	    (unsigned long long)s.produced, (unsigned long long)s.busy, (unsigned long long)s.sizeSkips, (unsigned long long)s.otherSkips,
+	    (unsigned long long)s.resets, s.width, s.height, s.generation, int(s.broken));
+	Check(!s.broken, "the producer never broke");
+
+	layer.Close();
+	rever_game_depth::TestReset();
+	SafeRelease(gameRtv);
+	SafeRelease(gameColour);
+	SafeRelease(gameSrv);
+	SafeRelease(gameUav);
+	SafeRelease(gameTex);
+	SafeRelease(gameTex2);
+	SafeRelease(gameCs);
+	SafeRelease(target.dsv);
+	SafeRelease(target.texture);
+	std::printf("%d checks, %d failed\n", g_checks, g_failures);
+	return g_failures ? 1 : 0;
+}
diff --git a/DrvOpenXR/XrBackend.cpp b/DrvOpenXR/XrBackend.cpp
index f5a8eea..c7bd31a 100644
--- a/DrvOpenXR/XrBackend.cpp
+++ b/DrvOpenXR/XrBackend.cpp
@@ -6,6 +6,10 @@
 #include "XrGenericTracker.h"
 #include "generated/interfaces/vrtypes.h"
 
+#if defined(_WIN32) && defined(SUPPORT_DX) && defined(SUPPORT_DX11)
+#include "ReverGameDepth.h" // Rever VR: Half-Life: Alyx's depth for Rever's layer
+#endif
+
 #ifdef _WIN32
 #define WIN32_LEAN_AND_MEAN
 #include <Windows.h>
@@ -466,8 +470,14 @@ void XrBackend::StoreEyeTexture(
 	Compositor& comp = *compPtr;
 
 	// If the session is inactive, we may be unable to write to the surface
-	if (sessionActive && renderingFrame)
+	if (sessionActive && renderingFrame) {
+#if defined(_WIN32) && defined(SUPPORT_DX) && defined(SUPPORT_DX11)
+		// Rever VR: Alyx's depth and the camera's motion for Rever's layer (ReverGameDepth.h), before the copy below
+		// releases the eye's image (where the layer upscales it); nothing unless REVER_ALYX_GAME_DEPTH=1
+		ReverGameDepthSubmit((int)eye, texture, bounds, (uint32_t)submitFlags, layer.pose, layer.fov, comp);
+#endif
 		comp.Invoke(texture, bounds, layer.subImage, (XruEye)eye, submitFlags);
+	}
 
 	submittedEyeTextures = true;
 
