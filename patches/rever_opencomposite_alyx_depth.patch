+
+#ifndef REVER_GAME_DEPTH_STANDALONE
+#if defined(SUPPORT_DX) && defined(SUPPORT_DX11)
+namespace {
+struct OpenVRDepthInfo { // vr::VRTextureDepthInfo_t
+	void* handle;
+	float mProjection[4][4];
+	float vRange[2];
+};
+static_assert(sizeof(OpenVRDepthInfo) == 80, "OpenVR's layout");
+static_assert(sizeof(vr::Texture_t) == 16, "OpenVR's layout");
+constexpr size_t kTextureWithPoseSize = 64; // vr::VRTextureWithPose_t: Texture_t + HmdMatrix34_t
+
+// The eye's rectangle as Compositor::Invoke will hand it to OpenXR (its own CalculateViewport on the same numbers), before
+// the copy: the size rever_xr_nr compares the channel's with.
+XrRect2Di EyeRect(Compositor& comp, const vr::VRTextureBounds_t* bounds, uint32_t texW, uint32_t texH)
+{
+	if (bounds && bounds->vMin == 0.0f && bounds->vMax == 1.0f && bounds->uMin == 0.0f && bounds->uMax == 1.0f)
+		bounds = nullptr;
+	XrRect2Di rect{};
+	if (!oovr_global_configuration.InvertUsingShaders()) {
+		// the whole texture copied, the eye's bounds as the view's rectangle
+		comp.CalculateViewport(bounds, static_cast<int32_t>(texW), static_cast<int32_t>(texH), true, rect);
+		return rect;
+	}
+	// DX11Compositor::CheckCreateSwapChain: a swapchain of the bounds' part of the texture, the whole of it the rectangle
+	uint32_t w = texW, h = texH;
+	if (bounds) {
+		if (std::fabs(bounds->uMax - bounds->uMin) > 0.1)
+			w = uint32_t(float(texW) * std::fabs(bounds->uMax - bounds->uMin));
+		if (std::fabs(bounds->vMax - bounds->vMin) > 0.1)
+			h = uint32_t(float(texH) * std::fabs(bounds->vMax - bounds->vMin));
+	}
+	comp.CalculateViewport(nullptr, static_cast<int32_t>(w), static_cast<int32_t>(h), true, rect);
+	return rect;
+}
+} // namespace
+
+void ReverGameDepthSubmit(int eye, const vr::Texture_t* texture, const vr::VRTextureBounds_t* bounds, uint32_t submitFlags,
+    const XrPosef& pose, const XrFovf& fov, Compositor& comp)
+{
+	if (!rever_game_depth::Armed() || eye < 0 || eye > 1 || !texture || !texture->handle || texture->eType != vr::TextureType_DirectX)
+		return;
+	ID3D11Texture2D* colour = nullptr;
+	if (FAILED(static_cast<IUnknown*>(texture->handle)->QueryInterface(__uuidof(ID3D11Texture2D), reinterpret_cast<void**>(&colour)))
+	    || !colour)
+		return;
+	D3D11_TEXTURE2D_DESC colourDesc{};
+	colour->GetDesc(&colourDesc);
+	colour->Release();
+
+	rever_game_depth::EyeInput in;
+	in.nowMs = GetTickCount64();
+	in.submitFlags = submitFlags;
+	const char* base = reinterpret_cast<const char*>(texture);
+	const bool withPose = (submitFlags & 0x08) != 0;
+	if (submitFlags & 0x10) { // Submit_TextureWithDepth: its depth after Texture_t, or after VRTextureWithPose_t
+		const auto* depth = reinterpret_cast<const OpenVRDepthInfo*>(base + (withPose ? kTextureWithPoseSize : sizeof(vr::Texture_t)));
+		if (depth->handle)
+			static_cast<IUnknown*>(depth->handle)->QueryInterface(__uuidof(ID3D11Texture2D), reinterpret_cast<void**>(&in.depth));
+		std::memcpy(in.projection, depth->mProjection, sizeof(in.projection));
+		in.vRange[0] = depth->vRange[0];
+		in.vRange[1] = depth->vRange[1];
+	}
+	if (withPose) { // the game's render pose (diagnostics): HmdMatrix34_t mDeviceToAbsoluteTracking, its rotation
+		const auto* m = reinterpret_cast<const float(*)[4]>(base + sizeof(vr::Texture_t));
+		for (int i = 0; i < 3; ++i)
+			for (int j = 0; j < 3; ++j)
+				in.renderRotation[i][j] = m[i][j];
+		in.hasRenderRotation = true;
+	}
+	if (bounds) {
+		in.bounds[0] = bounds->uMin;
+		in.bounds[1] = bounds->uMax;
+		in.bounds[2] = bounds->vMin;
+		in.bounds[3] = bounds->vMax;
+	}
+	in.pose.orientation[0] = pose.orientation.x;
+	in.pose.orientation[1] = pose.orientation.y;
+	in.pose.orientation[2] = pose.orientation.z;
+	in.pose.orientation[3] = pose.orientation.w;
+	in.pose.position[0] = pose.position.x;
+	in.pose.position[1] = pose.position.y;
+	in.pose.position[2] = pose.position.z;
+	in.viewTangents[0] = std::tan(fov.angleLeft);
+	in.viewTangents[1] = std::tan(fov.angleRight);
+	in.viewTangents[2] = std::tan(fov.angleUp);
+	in.viewTangents[3] = std::tan(fov.angleDown);
+	in.hasViewTangents = true;
+	const XrRect2Di rect = EyeRect(comp, bounds, colourDesc.Width, colourDesc.Height);
+	in.width = rect.extent.width;
+	in.height = rect.extent.height;
+	rever_game_depth::ProduceEye(eye, in);
+	if (in.depth)
+		in.depth->Release();
+}
+#endif // SUPPORT_DX && SUPPORT_DX11
+#endif // !REVER_GAME_DEPTH_STANDALONE
+
+#endif // _WIN32
