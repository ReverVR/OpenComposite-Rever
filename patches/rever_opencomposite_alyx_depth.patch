+
+void QuatFromYawPitch(double yawDeg, double pitchDeg, double q[4])
+{
+	const double y = yawDeg * 3.14159265358979 / 360.0, p = pitchDeg * 3.14159265358979 / 360.0;
+	// q = qYaw (about +y) * qPitch (about +x)
+	const double qy[4] = { 0, std::sin(y), 0, std::cos(y) }, qp[4] = { std::sin(p), 0, 0, std::cos(p) };
+	q[0] = qy[3] * qp[0] + qy[0] * qp[3] + qy[1] * qp[2] - qy[2] * qp[1];
+	q[1] = qy[3] * qp[1] - qy[0] * qp[2] + qy[1] * qp[3] + qy[2] * qp[0];
+	q[2] = qy[3] * qp[2] + qy[0] * qp[1] - qy[1] * qp[0] + qy[2] * qp[3];
+	q[3] = qy[3] * qp[3] - qy[0] * qp[0] - qy[1] * qp[1] - qy[2] * qp[2];
+}
+
+void QuatToMatrix(const double q[4], double m[3][3])
+{
+	const double x = q[0], y = q[1], z = q[2], w = q[3];
+	m[0][0] = 1 - 2 * (y * y + z * z);
+	m[0][1] = 2 * (x * y - z * w);
+	m[0][2] = 2 * (x * z + y * w);
+	m[1][0] = 2 * (x * y + z * w);
+	m[1][1] = 1 - 2 * (x * x + z * z);
+	m[1][2] = 2 * (y * z - x * w);
+	m[2][0] = 2 * (x * z - y * w);
+	m[2][1] = 2 * (y * z + x * w);
+	m[2][2] = 1 - 2 * (x * x + y * y);
+}
+
+struct Head {
+	double q[4];
+	double position[3];
+};
+
+Eye MakeEye(int e, const Head& head)
+{
+	Eye eye{};
+	// the left eye's tangents of the headset probe's mProjection, mirrored for the right
+	const double left[4] = { -1.4919, 1.0938, 1.0520, -1.5582 };
+	eye.tangents[0] = e == 0 ? left[0] : -left[1];
+	eye.tangents[1] = e == 0 ? left[1] : -left[0];
+	eye.tangents[2] = left[2];
+	eye.tangents[3] = left[3];
+	QuatToMatrix(head.q, eye.rotation);
+	const double offset = e == 0 ? -0.032 : 0.032;
+	for (int i = 0; i < 3; ++i)
+		eye.position[i] = head.position[i] + eye.rotation[i][0] * offset;
+	return eye;
+}
+
+void Projection(const Eye& eye, float P[4][4])
+{
+	std::memset(P, 0, sizeof(float) * 16);
+	const double l = eye.tangents[0], r = eye.tangents[1], u = eye.tangents[2], d = eye.tangents[3];
+	P[0][0] = float(2.0 / (r - l));
+	P[0][2] = float((r + l) / (r - l));
+	P[1][1] = float(2.0 / (u - d));
+	P[1][2] = float((u + d) / (u - d));
+	P[2][2] = kP22;
+	P[2][3] = kP23;
+	P[3][2] = -1.f;
+}
+
+// The scene (world metres): a wall at z = -6, a floor at y = -1.6, a sphere; anything else is the sky. Object id: 0 sky.
+double Hit(const double o[3], const double d[3], int& id)
+{
+	double best = -1;
+	id = 0;
+	const double c[3] = { 0.4, 0.0, -2.5 }, radius = 0.6;
+	const double oc[3] = { o[0] - c[0], o[1] - c[1], o[2] - c[2] };
+	const double a = d[0] * d[0] + d[1] * d[1] + d[2] * d[2], b = oc[0] * d[0] + oc[1] * d[1] + oc[2] * d[2];
+	const double cc = oc[0] * oc[0] + oc[1] * oc[1] + oc[2] * oc[2] - radius * radius;
+	const double disc = b * b - a * cc;
+	if (disc >= 0) {
+		const double s = (-b - std::sqrt(disc)) / a;
+		if (s > 0) {
+			best = s;
+			id = 1;
+		}
+	}
+	if (d[2] < 0) {
+		const double s = (-6.0 - o[2]) / d[2];
+		const double x = o[0] + s * d[0], y = o[1] + s * d[1];
+		if (s > 0 && x > -4 && x < 4 && y > -1.6 && y < 2.5 && (best < 0 || s < best)) {
+			best = s;
+			id = 2;
+		}
+	}
+	if (d[1] < 0) {
+		const double s = (-1.6 - o[1]) / d[1];
+		const double x = o[0] + s * d[0], z = o[2] + s * d[2];
+		if (s > 0 && x > -4 && x < 4 && z > -6 && z < 1 && (best < 0 || s < best)) {
+			best = s;
+			id = 3;
+		}
+	}
+	return best;
+}
+
+const char kSceneShader[] = R"(
+cbuffer Scene : register(b0) {
+    float4 rect; float4 tangents; float4 rot0; float4 rot1; float4 rot2; float4 position; float4 depthMap;
+};
+float4 VS(uint id : SV_VertexID) : SV_Position {
+    float2 uv = float2((id << 1) & 2, id & 2);
+    return float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);
+}
+float Hit(float3 o, float3 d) {
+    float best = -1;
+    float3 c = float3(0.4, 0.0, -2.5);
+    float3 oc = o - c;
+    float a = dot(d, d), b = dot(oc, d), cc = dot(oc, oc) - 0.36;
+    float disc = b * b - a * cc;
+    if (disc >= 0) { float s = (-b - sqrt(disc)) / a; if (s > 0) best = s; }
+    if (d.z < 0) {
+        float s = (-6.0 - o.z) / d.z; float x = o.x + s * d.x, y = o.y + s * d.y;
+        if (s > 0 && x > -4 && x < 4 && y > -1.6 && y < 2.5 && (best < 0 || s < best)) best = s;
+    }
+    if (d.y < 0) {
+        float s = (-1.6 - o.y) / d.y; float x = o.x + s * d.x, z = o.z + s * d.z;
+        if (s > 0 && x > -4 && x < 4 && z > -6 && z < 1 && (best < 0 || s < best)) best = s;
+    }
+    return best;
+}
+float PS(float4 pos : SV_Position) : SV_Depth {
+    float2 uv = (pos.xy - rect.xy) / rect.zw;
+    float3 v = float3(lerp(tangents.x, tangents.y, uv.x), lerp(tangents.z, tangents.w, uv.y), -1);
+    float3 d = float3(dot(rot0.xyz, v), dot(rot1.xyz, v), dot(rot2.xyz, v));
+    float s = Hit(position.xyz, d);
+    if (s <= 0) discard;
+    return -depthMap.x + depthMap.y / s;
+}
+)";
+
+struct SceneConstants {
+	float rect[4];
+	float tangents[4];
+	float rot0[4], rot1[4], rot2[4];
+	float position[4];
+	float depthMap[4];
+};
