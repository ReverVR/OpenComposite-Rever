+// Rever VR (GPL-3.0, Rever's OpenComposite), 2026-11-19 - Half-Life: Alyx's own depth for Rever's DLSS / FSR (KB ALX-002,
+// step 2; user: "si").
+//
+// With +vr_depth_submit 1 +vr_enable_depth_resolve 1 on its launch line, Alyx submits each eye with
+// Submit_TextureWithDepth (flags 0x218: pose, depth, motion with a null handle): its depth (D24S8, the eye at the same
+// bounds as the colour) and mProjection (its Z row remapped to 0.05..0.95). Here, on the game's own D3D11 device and
+// BEFORE OpenComposite copies the eye (Compositor::Invoke releases the eye's swapchain image, and that release is where
+// rever_xr_nr upscales it), a compute pass writes the channel rever_xr_nr's srinputs reads - Local\ReverVR_DLSS_SR_Inputs,
+// version 1, as rever_vk_depth's producer does for Batman and the Alien bridge's camera mode:
+// - per eye an R32_FLOAT depth, inverted with an infinite far plane (near_ref / view distance; 0 for the sky; flags 1),
+//   cropped to the eye and of the size the layer sees (the projection view's imageRect extent, checked every frame);
+// - per eye R16G16_FLOAT motion vectors of the camera: each pixel at its distance, from this frame's eye pose into the
+//   previous frame's (the OpenXR views OpenComposite hands down for each frame - the poses Alyx renders with), through
+//   the previous frame's projection; render pixels, pointing to where the point was (rever_xr_nr's MotionPS
+//   convention). The sky carries the rotation only. What moves on its own comes from the layer's optical flow on top
+//   (srgameflow);
+// - both textures shared by name (Local\ReverVR_SR_<pid>_<generation>_<eye>D / M) with keyed mutexes: taken with key 0
+//   (the layer gave them back) or key 1 (it never took the last ones), released with key 1; then the eye's jitter phase
+//   (0: Alyx does not jitter) and its sequence one up. A key the reader holds skips the frame: the game never waits.
+// A cut (the first frame, a new size, OpenVR's discontinuity flag 0x20, a pose jump, a gap over 250 ms) hands zero motion
+// for that frame. REVER_ALYX_GAME_DEPTH=1 (Rever's session file) arms it; anything else: nothing at all.
+#ifdef _WIN32
+
+#ifndef REVER_GAME_DEPTH_STANDALONE
+#include "XrBackend.h"
+
+#include "../OpenOVR/Misc/Config.h"
+#endif
+
+#include "ReverGameDepth.h"
+
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+#include <d3d11_1.h>
+#include <d3dcompiler.h>
+#include <dxgi1_2.h>
+
+#include <cmath>
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+
+#pragma comment(lib, "d3dcompiler.lib")
+
+namespace rever_game_depth {
+namespace {
+
+// rever_xr_nr's SrInputsBlock (layer.cpp), version 1 - the only one the sealed layer opens
+struct SrInputsBlock {
+	uint32_t magic; // "RVSI", written last
+	uint32_t version;
+	uint32_t pid; // the textures' names
+	volatile LONG generation; // a new one whenever the textures are made again
+	uint32_t width, height; // the eye's size: the layer takes nothing of another size
+	uint32_t flags; // 1: depth inverted (1 near, 0 far)
+	uint32_t reserved;
+	struct Eye {
+		volatile LONG seq;
+		uint32_t phase; // the jitter phase rendered with (0: none)
+		uint32_t reserved[2];
+	} eyes[2];
+};
+static_assert(sizeof(SrInputsBlock) == 64, "rever_xr_nr's layout");
+constexpr uint32_t kMagic = 0x49535652; // "RVSI"
+constexpr uint32_t kFlagInverted = 1;
+// rever_xr_nr's names: the block, and the textures' "Local\ReverVR_SR_<pid>_<generation>_<eye><D|M>". Only the desk test
+// (built apart, REVER_GAME_DEPTH_STANDALONE) can use others, so it never touches a running game's channel.
+#ifdef REVER_GAME_DEPTH_STANDALONE
+const wchar_t* g_blockName = L"Local\\ReverVR_DLSS_SR_Inputs";
+const wchar_t* g_texturePrefix = L"Local\\ReverVR_SR_";
+#else
+constexpr const wchar_t* g_blockName = L"Local\\ReverVR_DLSS_SR_Inputs";
+constexpr const wchar_t* g_texturePrefix = L"Local\\ReverVR_SR_";
+#endif
+
+constexpr uint64_t kGapMs = 250; // longer between two frames of an eye: a cut
+constexpr float kJumpMetres = 0.5f; // the eye moved more in one frame: a cut (recentre, tracking lost)
+constexpr float kJumpDegrees = 45.f;
+constexpr int kSourceViews = 4; // the game's depth textures kept viewed (one per texture it submits)
+
+// the shader's cbuffer, 16-byte rows
+struct Constants {
+	int32_t origin[2]; // the eye's rectangle in the game's depth texture
+	int32_t last[2]; // the game's depth texture's last pixel
+	float size[2]; // the eye as the layer sees it
+	float stepSize[2]; // depth pixels per output pixel
+	float tanNow[4]; // left, right, up, down tangents of the game's projection now
+	float tanThen[4]; // the same, the frame before
+	float row0[4], row1[4], row2[4]; // xyz: a view direction now into the previous view; w: the eye's move there (m)
+	float k, m22, nearRef; // inverted depth = saturate(k * (raw + m22)); view distance = nearRef / inverted
+	uint32_t mode; // 1: no previous frame (zero motion); 2: a multisampled depth (its sample 0)
+};
+static_assert(sizeof(Constants) == 128, "the shader's cbuffer");
+
+const char kShader[] = R"(
+Texture2D<float> depthTex : register(t0);
+Texture2DMS<float> depthMs : register(t1);
+RWTexture2D<float> outDepth : register(u0);
+RWTexture2D<float2> outMotion : register(u1);
+cbuffer Eye : register(b0) {
+    int2 origin; int2 last; float2 size; float2 stepSize;
+    float4 tanNow; float4 tanThen; float4 row0; float4 row1; float4 row2;
+    float k; float m22; float nearRef; uint mode;
+};
+[numthreads(8, 8, 1)]
+void CS(uint3 id : SV_DispatchThreadID) {
+    if (id.x >= (uint)size.x || id.y >= (uint)size.y) return;
+    int2 at = clamp(origin + int2((float2(id.xy) + 0.5) * stepSize), int2(0, 0), last);
+    float raw = (mode & 2u) != 0u ? depthMs.Load(at, 0) : depthTex.Load(int3(at, 0));
+    float inverted = saturate(k * (raw + m22));
+    outDepth[id.xy] = inverted;
+    float2 motion = float2(0, 0);
+    if ((mode & 1u) == 0u) {
+        float2 uv = (float2(id.xy) + 0.5) / size;
+        float3 now = float3(lerp(tanNow.x, tanNow.y, uv.x), lerp(tanNow.z, tanNow.w, uv.y), -1.0);
+        float3 before = float3(dot(row0.xyz, now), dot(row1.xyz, now), dot(row2.xyz, now));
+        if (inverted > 1e-7) before = before * (nearRef / inverted) + float3(row0.w, row1.w, row2.w);
+        if (before.z < -1e-4) {
+            float2 t = before.xy / -before.z;
+            float2 uvBefore = float2((t.x - tanThen.x) / (tanThen.y - tanThen.x), (t.y - tanThen.z) / (tanThen.w - tanThen.z));
+            motion = (uvBefore - uv) * size;
+        }
+    }
+    outMotion[id.xy] = motion;
+}
+)";
+
+struct Output {
+	ID3D11Texture2D* texture = nullptr;
+	ID3D11UnorderedAccessView* uav = nullptr;
+	IDXGIKeyedMutex* mutex = nullptr;
+	HANDLE handle = nullptr; // the name lives as long as it is open
+};
+
+struct SourceView {
+	ID3D11Texture2D* texture = nullptr; // identity only: the view holds it
+	ID3D11ShaderResourceView* srv = nullptr;
+	bool multisampled = false;
+	uint32_t width = 0, height = 0;
+	uint64_t used = 0;
+};
+
+struct History {
+	bool valid = false;
+	Pose pose;
+	float tangents[4] = {};
+	uint64_t atMs = 0;
+};
+
+struct Projection {
+	float tangents[4] = {}; // left, right, up, down
+	float k = 0, m22 = 0, nearRef = 0;
+};
+
+struct State {
+	bool switchRead = false, armed = false, broken = false;
+	ID3D11Device* device = nullptr;
+	ID3D11DeviceContext* context = nullptr;
+	ID3D11ComputeShader* shader = nullptr;
+	ID3D11Buffer* constants = nullptr;
+	HANDLE blockMap = nullptr;
+	SrInputsBlock* block = nullptr;
+	Output depth[2], motion[2];
+	uint32_t width = 0, height = 0;
+	LONG generation = 0;
+	SourceView sources[kSourceViews];
+	uint64_t sourceClock = 0, sourceViewsMade = 0;
+	History history[2];
+	Stats total;
+	// this second's
+	uint64_t windowStart = 0, wProduced = 0, wBusy = 0, wSize = 0, wOther = 0, wResets = 0;
+	float wGapMax = -1.f;
+	// said once
+	bool saidFirst[2] = {}, saidNoDepth = false, saidSize = false, saidProjection = false, saidFormat = false, saidFlip = false,
+	     saidRange = false;
+};
+State g;
+void (*g_sink)(const char*) = nullptr;
+
+template <typename T>
+void SafeRelease(T*& p)
+{
+	if (p)
+		p->Release();
+	p = nullptr;
+}
+
+void Say(const char* format, ...)
+{
+	char text[1024];
+	va_list args;
+	va_start(args, format);
+	vsnprintf(text, sizeof(text), format, args);
+	va_end(args);
+	char line[1100];
+	snprintf(line, sizeof(line), "Rever VR game depth: %s", text);
+	if (g_sink)
+		g_sink(line);
+#ifdef REVER_GAME_DEPTH_STANDALONE
+	else {
+		fputs(line, stdout);
+		fputc('\n', stdout);
+	}
+#else
+	OOVR_LOG(line);
+#endif
+}
+
+bool Fail(const char* what, HRESULT hr)
+{
+	Say("%s (0x%08lx): off for this session", what, (unsigned long)hr);
+	g.broken = true;
+	g.total.broken = true;
+	return false;
+}
+
+void ReleaseOutputs()
+{
+	Output* groups[2] = { g.depth, g.motion };
+	for (Output* group : groups)
+		for (int e = 0; e < 2; ++e) {
+			Output& o = group[e];
+			SafeRelease(o.uav);
+			SafeRelease(o.mutex);
+			SafeRelease(o.texture);
+			if (o.handle)
+				CloseHandle(o.handle);
+			o = Output{};
+		}
+	g.width = g.height = 0;
+}
+
+void ReleaseSources()
+{
+	for (SourceView& s : g.sources) {
+		SafeRelease(s.srv);
+		s = SourceView{};
+	}
+}
+
+// what was made on the game's device (the block stays: the same process, a new generation)
+void DropDevice()
+{
+	ReleaseOutputs();
+	ReleaseSources();
+	SafeRelease(g.shader);
+	SafeRelease(g.constants);
+	SafeRelease(g.context);
+	SafeRelease(g.device);
+	g.history[0].valid = g.history[1].valid = false;
+	if (g.block) {
+		g.block->width = g.block->height = 0;
+		MemoryBarrier();
+	}
+}
+
+bool EnsureBlock()
+{
+	if (g.block)
+		return true;
+	g.blockMap = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, sizeof(SrInputsBlock), g_blockName);
+	if (!g.blockMap)
+		return Fail("Local\\ReverVR_DLSS_SR_Inputs not made", HRESULT_FROM_WIN32(GetLastError()));
+	g.block = static_cast<SrInputsBlock*>(MapViewOfFile(g.blockMap, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(SrInputsBlock)));
+	if (!g.block)
+		return Fail("Local\\ReverVR_DLSS_SR_Inputs not mapped", HRESULT_FROM_WIN32(GetLastError()));
+	std::memset(g.block, 0, sizeof(SrInputsBlock));
+	g.block->version = 1;
+	g.block->pid = GetCurrentProcessId();
+	g.block->flags = kFlagInverted;
+	MemoryBarrier();
+	g.block->magic = kMagic; // last: a reader checks it
+	return true;
+}
+
+bool Init(ID3D11Device* device)
+{
+	g.device = device;
+	g.device->AddRef();
+	g.device->GetImmediateContext(&g.context);
+	const D3D_FEATURE_LEVEL level = g.device->GetFeatureLevel();
+	if (level < D3D_FEATURE_LEVEL_11_0)
+		return Fail("the game's D3D11 device is below feature level 11_0", E_NOTIMPL);
+	ID3DBlob* code = nullptr;
+	ID3DBlob* errors = nullptr;
+	HRESULT hr = D3DCompile(kShader, sizeof(kShader) - 1, "rever_game_depth", nullptr, nullptr, "CS", "cs_5_0",
+	    D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+	if (FAILED(hr)) {
+		Say("the compute shader did not compile: %s", errors ? static_cast<const char*>(errors->GetBufferPointer()) : "?");
+		SafeRelease(errors);
+		return Fail("compute shader", hr);
+	}
+	SafeRelease(errors);
+	hr = g.device->CreateComputeShader(code->GetBufferPointer(), code->GetBufferSize(), nullptr, &g.shader);
+	SafeRelease(code);
+	if (FAILED(hr))
+		return Fail("compute shader not made", hr);
+	D3D11_BUFFER_DESC cb{};
+	cb.ByteWidth = sizeof(Constants);
+	cb.Usage = D3D11_USAGE_DEFAULT;
+	cb.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+	hr = g.device->CreateBuffer(&cb, nullptr, &g.constants);
+	if (FAILED(hr))
+		return Fail("constant buffer not made", hr);
+	if (!EnsureBlock())
+		return false;
+	Say("ready on the game's D3D11 device (feature level %x): Local\\ReverVR_DLSS_SR_Inputs version 1, depth inverted, "
+	    "the camera's motion",
+	    (unsigned)level);
+	return true;
+}
+
+bool MakeOutput(Output& o, DXGI_FORMAT format, const wchar_t* name)
+{
+	D3D11_TEXTURE2D_DESC desc{};
+	desc.Width = g.width;
+	desc.Height = g.height;
+	desc.MipLevels = desc.ArraySize = 1;
+	desc.Format = format;
+	desc.SampleDesc.Count = 1;
+	desc.Usage = D3D11_USAGE_DEFAULT;
+	desc.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET | D3D11_BIND_UNORDERED_ACCESS;
+	desc.MiscFlags = D3D11_RESOURCE_MISC_SHARED_NTHANDLE | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX;
+	HRESULT hr = g.device->CreateTexture2D(&desc, nullptr, &o.texture);
+	if (FAILED(hr))
+		return Fail("a shared texture not made", hr);
+	IDXGIResource1* resource = nullptr;
+	hr = o.texture->QueryInterface(__uuidof(IDXGIResource1), reinterpret_cast<void**>(&resource));
+	if (SUCCEEDED(hr))
+		hr = resource->CreateSharedHandle(nullptr, DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE, name, &o.handle);
+	SafeRelease(resource);
+	if (SUCCEEDED(hr))
+		hr = o.texture->QueryInterface(__uuidof(IDXGIKeyedMutex), reinterpret_cast<void**>(&o.mutex));
+	if (SUCCEEDED(hr))
+		hr = g.device->CreateUnorderedAccessView(o.texture, nullptr, &o.uav);
+	if (FAILED(hr)) {
+		Say("%ls not shared", name);
+		return Fail("a shared texture not named", hr);
+	}
+	return true;
+}
+
+bool EnsureOutputs(uint32_t width, uint32_t height)
+{
+	if (g.width == width && g.height == height && g.depth[0].texture)
+		return true;
+	ReleaseOutputs();
+	g.width = width;
+	g.height = height;
+	static LONG generations = 0; // unique in the process: rever_xr_nr may still hold an older name open
+	const LONG next = InterlockedIncrement(&generations);
+	const unsigned pid = unsigned(GetCurrentProcessId());
+	for (int e = 0; e < 2; ++e) {
+		wchar_t name[128];
+		swprintf_s(name, L"%s%u_%ld_%dD", g_texturePrefix, pid, next, e);
+		if (!MakeOutput(g.depth[e], DXGI_FORMAT_R32_FLOAT, name)) {
+			ReleaseOutputs();
+			return false;
+		}
+		swprintf_s(name, L"%s%u_%ld_%dM", g_texturePrefix, pid, next, e);
+		if (!MakeOutput(g.motion[e], DXGI_FORMAT_R16G16_FLOAT, name)) {
+			ReleaseOutputs();
+			return false;
+		}
+	}
+	g.width = width;
+	g.height = height;
+	g.generation = next;
+	g.block->width = width;
+	g.block->height = height;
+	MemoryBarrier();
+	InterlockedExchange(&g.block->generation, next);
+	g.history[0].valid = g.history[1].valid = false;
+	Say("depth and motion textures %ux%u per eye ready (generation %ld)", width, height, next);
+	return true;
+}
+
+// The game's depth texture viewed for the pass (R24G8 as R24_UNORM_X8 and the other depth formats likewise); null when it
+// cannot be read.
+SourceView* Source(ID3D11Texture2D* texture)
+{
+	++g.sourceClock;
+	SourceView* slot = nullptr;
+	for (SourceView& s : g.sources) {
+		if (s.texture == texture && s.srv) {
+			s.used = g.sourceClock;
+			return &s;
+		}
+		if (!slot || !s.srv || (slot->srv && s.used < slot->used))
+			slot = &s;
+	}
+	D3D11_TEXTURE2D_DESC d{};
+	texture->GetDesc(&d);
+	DXGI_FORMAT view = DXGI_FORMAT_UNKNOWN;
+	switch (d.Format) {
+	case DXGI_FORMAT_R24G8_TYPELESS:
+	case DXGI_FORMAT_R24_UNORM_X8_TYPELESS:
+		view = DXGI_FORMAT_R24_UNORM_X8_TYPELESS;
+		break;
+	case DXGI_FORMAT_R32_TYPELESS:
+	case DXGI_FORMAT_R32_FLOAT:
+		view = DXGI_FORMAT_R32_FLOAT;
+		break;
+	case DXGI_FORMAT_R32G8X24_TYPELESS:
+	case DXGI_FORMAT_R32_FLOAT_X8X24_TYPELESS:
+		view = DXGI_FORMAT_R32_FLOAT_X8X24_TYPELESS;
+		break;
+	case DXGI_FORMAT_R16_TYPELESS:
+	case DXGI_FORMAT_R16_UNORM:
+		view = DXGI_FORMAT_R16_UNORM;
+		break;
+	default:
+		break;
+	}
+	if (view == DXGI_FORMAT_UNKNOWN || !(d.BindFlags & D3D11_BIND_SHADER_RESOURCE) || d.ArraySize != 1) {
+		if (!g.saidFormat) {
+			g.saidFormat = true;
+			Say("the game's depth cannot be read (%ux%u DXGI format %d, bind 0x%x, array %u): nothing handed", d.Width,
+			    d.Height, int(d.Format), d.BindFlags, d.ArraySize);
+		}
+		return nullptr;
+	}
+	D3D11_SHADER_RESOURCE_VIEW_DESC sv{};
+	sv.Format = view;
+	if (d.SampleDesc.Count > 1) {
+		sv.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2DMS;
+	} else {
+		sv.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+		sv.Texture2D.MostDetailedMip = 0;
+		sv.Texture2D.MipLevels = 1;
+	}
+	ID3D11ShaderResourceView* srv = nullptr;
+	const HRESULT hr = g.device->CreateShaderResourceView(texture, &sv, &srv);
+	if (FAILED(hr)) {
+		if (!g.saidFormat) {
+			g.saidFormat = true;
+			Say("the game's depth not viewed (0x%08lx, DXGI format %d): nothing handed", (unsigned long)hr, int(d.Format));
+		}
+		return nullptr;
+	}
+	SafeRelease(slot->srv);
+	slot->texture = texture;
+	slot->srv = srv;
+	slot->multisampled = d.SampleDesc.Count > 1;
+	slot->width = d.Width;
+	slot->height = d.Height;
+	slot->used = g.sourceClock;
+	if (++g.sourceViewsMade <= 8)
+		Say("the game's depth: %ux%u DXGI format %d, %u samples, bind 0x%x (read as DXGI format %d)", d.Width, d.Height,
+		    int(d.Format), d.SampleDesc.Count, d.BindFlags, int(view));
+	return slot;
+}
+
+// OpenVR's projection (GetProjectionMatrix's shape): x' = P00 x + P02 z, y' = P11 y + P12 z, z' = P22 z + P23, w' = -z.
+bool ReadProjection(const float (&P)[4][4], Projection& out)
+{
+	const auto zero = [](float v) { return std::fabs(v) < 1e-5f; };
+	if (!(P[0][0] > 0) || !(P[1][1] > 0) || !zero(P[0][1]) || !zero(P[0][3]) || !zero(P[1][0]) || !zero(P[1][3])
+	    || !zero(P[2][0]) || !zero(P[2][1]) || !zero(P[3][0]) || !zero(P[3][1]) || !zero(P[3][3]) || std::fabs(P[3][2] + 1.f) > 1e-4f
+	    || zero(P[2][3]))
+		return false;
+	const double m00 = P[0][0], m02 = P[0][2], m11 = P[1][1], m12 = P[1][2], m22 = P[2][2], m23 = P[2][3];
+	out.tangents[0] = float((m02 - 1.0) / m00);
+	out.tangents[1] = float((m02 + 1.0) / m00);
+	out.tangents[2] = float((m12 + 1.0) / m11);
+	out.tangents[3] = float((m12 - 1.0) / m11);
+	// a raw depth z (0..1) lies at the view distance d = m23 / (z + m22); the nearest the buffer can hold is the reference
+	const double d0 = m22 != 0 ? m23 / m22 : -1.0, d1 = (1.0 + m22) != 0 ? m23 / (1.0 + m22) : -1.0;
+	double nearRef = -1.0;
+	if (d0 > 0)
+		nearRef = d0;
+	if (d1 > 0 && (nearRef < 0 || d1 < nearRef))
+		nearRef = d1;
+	if (!(nearRef > 0))
+		return false;
+	out.nearRef = float(nearRef);
+	out.m22 = float(m22);
+	out.k = float(nearRef / m23);
+	return true;
+}
+
+void QuatToMatrix(const float q[4], float m[3][3])
+{
+	const float x = q[0], y = q[1], z = q[2], w = q[3];
+	m[0][0] = 1 - 2 * (y * y + z * z);
+	m[0][1] = 2 * (x * y - z * w);
+	m[0][2] = 2 * (x * z + y * w);
+	m[1][0] = 2 * (x * y + z * w);
+	m[1][1] = 1 - 2 * (x * x + z * z);
+	m[1][2] = 2 * (y * z - x * w);
+	m[2][0] = 2 * (x * z - y * w);
+	m[2][1] = 2 * (y * z + x * w);
+	m[2][2] = 1 - 2 * (x * x + y * y);
+}
+
+// R = then^T * now (a view direction now into the previous view), T = then^T * (position now - position then)
+void Relative(const Pose& now, const Pose& then, float r[3][3], float t[3])
+{
+	float a[3][3], b[3][3];
+	QuatToMatrix(now.orientation, a);
+	QuatToMatrix(then.orientation, b);
+	const float d[3] = { now.position[0] - then.position[0], now.position[1] - then.position[1], now.position[2] - then.position[2] };
+	for (int i = 0; i < 3; ++i) {
+		for (int j = 0; j < 3; ++j)
+			r[i][j] = b[0][i] * a[0][j] + b[1][i] * a[1][j] + b[2][i] * a[2][j];
+		t[i] = b[0][i] * d[0] + b[1][i] * d[1] + b[2][i] * d[2];
+	}
+}
+
+float AngleDegrees(const float a[3][3], const float b[3][3])
+{
+	float trace = 0;
+	for (int i = 0; i < 3; ++i)
+		for (int j = 0; j < 3; ++j)
+			trace += a[j][i] * b[j][i];
+	const float c = (trace - 1.f) * 0.5f;
+	return std::acos(c > 1.f ? 1.f : (c < -1.f ? -1.f : c)) * 57.2957795f;
+}
+
+bool Take(IDXGIKeyedMutex* mutex, UINT& key)
+{
+	if (mutex->AcquireSync(0, 0) == S_OK) {
+		key = 0; // the layer gave it back
+		return true;
+	}
+	if (mutex->AcquireSync(1, 0) == S_OK) {
+		key = 1; // the layer never took the last one: written over
+		return true;
+	}
+	return false; // the reader holds it now: this frame is skipped, never waited for
+}
+
+void Tick(uint64_t now)
+{
+	if (!g.windowStart) {
+		g.windowStart = now;
+		return;
+	}
+	if (now - g.windowStart < 1000)
+		return;
+	if (g.wProduced || g.wBusy || g.wSize || g.wOther) {
+		char gap[64] = "";
+		if (g.wGapMax >= 0)
+			snprintf(gap, sizeof(gap), "; render pose vs OpenXR view %.2f deg max", g.wGapMax);
+		Say("%llu eyes produced, %llu skipped (keys busy %llu, size %llu, other %llu) in %.1f s; %ux%u per eye (generation "
+		    "%ld); resets %llu (%llu so far)%s",
+		    (unsigned long long)g.wProduced, (unsigned long long)(g.wBusy + g.wSize + g.wOther), (unsigned long long)g.wBusy,
+		    (unsigned long long)g.wSize, (unsigned long long)g.wOther, double(now - g.windowStart) / 1000.0, g.width, g.height,
+		    g.generation, (unsigned long long)g.wResets, (unsigned long long)g.total.resets, gap);
+	}
+	g.windowStart = now;
+	g.wProduced = g.wBusy = g.wSize = g.wOther = g.wResets = 0;
+	g.wGapMax = -1.f;
+}
+
+bool SkipOther(History& history)
+{
+	++g.total.otherSkips;
+	++g.wOther;
+	history.valid = false;
+	return false;
+}
+
+void Dispatch(int eye, const SourceView& source, const Constants& c)
+{
+	ID3D11DeviceContext* ctx = g.context;
+	// the game's compute state, given back as it was
+	ID3D11ComputeShader* oldShader = nullptr;
+	ID3D11ClassInstance* oldInstances[256] = {};
+	UINT oldInstanceCount = 256;
+	ctx->CSGetShader(&oldShader, oldInstances, &oldInstanceCount);
+	ID3D11ShaderResourceView* oldSrv[2] = {};
+	ctx->CSGetShaderResources(0, 2, oldSrv);
+	ID3D11UnorderedAccessView* oldUav[2] = {};
+	ctx->CSGetUnorderedAccessViews(0, 2, oldUav);
+	ID3D11Buffer* oldCb = nullptr;
+	ctx->CSGetConstantBuffers(0, 1, &oldCb);
+	// the game's depth still bound for writing (its depth-stencil view) would leave our view of it empty: unbound for the pass
+	ID3D11RenderTargetView* rtvs[D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT] = {};
+	ID3D11DepthStencilView* dsv = nullptr;
+	ctx->OMGetRenderTargets(D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT, rtvs, &dsv);
+	UINT rtvCount = 0;
+	for (UINT i = 0; i < D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT; ++i)
+		if (rtvs[i])
+			rtvCount = i + 1;
+	bool dsvMoved = false;
+	if (dsv) {
+		ID3D11Resource* bound = nullptr;
+		dsv->GetResource(&bound);
+		dsvMoved = bound == source.texture;
+		SafeRelease(bound);
+	}
+	if (dsvMoved)
+		ctx->OMSetRenderTargetsAndUnorderedAccessViews(rtvCount, rtvs, nullptr, 0, D3D11_KEEP_UNORDERED_ACCESS_VIEWS, nullptr, nullptr);
+
+	ctx->UpdateSubresource(g.constants, 0, nullptr, &c, 0, 0);
+	ID3D11ShaderResourceView* srvs[2] = { source.multisampled ? nullptr : source.srv, source.multisampled ? source.srv : nullptr };
+	ID3D11UnorderedAccessView* uavs[2] = { g.depth[eye].uav, g.motion[eye].uav };
+	ctx->CSSetShader(g.shader, nullptr, 0);
+	ctx->CSSetConstantBuffers(0, 1, &g.constants);
+	ctx->CSSetShaderResources(0, 2, srvs);
+	ctx->CSSetUnorderedAccessViews(0, 2, uavs, nullptr);
+	ctx->Dispatch((g.width + 7) / 8, (g.height + 7) / 8, 1);
+
+	const UINT keepCounts[2] = { UINT(-1), UINT(-1) };
+	ctx->CSSetUnorderedAccessViews(0, 2, oldUav, keepCounts);
+	ctx->CSSetShaderResources(0, 2, oldSrv);
+	ctx->CSSetConstantBuffers(0, 1, &oldCb);
+	ctx->CSSetShader(oldShader, oldInstanceCount ? oldInstances : nullptr, oldInstanceCount);
+	if (dsvMoved)
+		ctx->OMSetRenderTargetsAndUnorderedAccessViews(rtvCount, rtvs, dsv, 0, D3D11_KEEP_UNORDERED_ACCESS_VIEWS, nullptr, nullptr);
+	SafeRelease(oldShader);
+	for (UINT i = 0; i < oldInstanceCount && i < 256; ++i)
+		SafeRelease(oldInstances[i]);
+	for (int i = 0; i < 2; ++i) {
+		SafeRelease(oldSrv[i]);
+		SafeRelease(oldUav[i]);
+	}
+	SafeRelease(oldCb);
+	for (ID3D11RenderTargetView*& rtv : rtvs)
+		SafeRelease(rtv);
+	SafeRelease(dsv);
+}
+
+} // namespace
+
+bool Armed()
+{
+	if (!g.switchRead) {
+		g.switchRead = true;
+		char value[16] = {};
+		const DWORD n = GetEnvironmentVariableA("REVER_ALYX_GAME_DEPTH", value, sizeof(value));
+		g.armed = n == 1 && value[0] == '1';
+		if (g.armed)
+			Say("on (REVER_ALYX_GAME_DEPTH=1): the game's depth and the camera's motion into Rever's layer (srinputs)");
+		else
+			Say("off (REVER_ALYX_GAME_DEPTH=%s): no producer", n > 0 && n < sizeof(value) ? value : "unset");
+	}
+	return g.armed;
+}
+
+bool ProduceEye(int eye, const EyeInput& in)
+{
+	if (!Armed() || g.broken || eye < 0 || eye > 1)
+		return false;
+	Tick(in.nowMs);
+	History& history = g.history[eye];
+	if (!in.depth) {
+		++g.total.noDepth;
+		history.valid = false;
+		if (!g.saidNoDepth) {
+			g.saidNoDepth = true;
+			Say("eye %d submitted without the game's depth (flags 0x%x): it needs +vr_depth_submit 1 +vr_enable_depth_resolve 1 on "
+			    "the launch line and no layer that clears the depth bit (the global ReShade)",
+			    eye, in.submitFlags);
+		}
+		return false;
+	}
+	ID3D11Device* device = nullptr;
+	in.depth->GetDevice(&device);
+	if (!device)
+		return SkipOther(history);
+	if (device != g.device) {
+		if (g.device) {
+			Say("the game's D3D11 device changed: everything made again");
+			DropDevice();
+		}
+		const bool ok = Init(device);
+		device->Release();
+		if (!ok)
+			return false;
+	} else {
+		device->Release();
+	}
+
+	Projection now;
+	if (!ReadProjection(in.projection, now)) {
+		if (!g.saidProjection) {
+			g.saidProjection = true;
+			const float(&P)[4][4] = in.projection;
+			Say("the game's projection is not OpenVR's usual shape [%g %g %g %g | %g %g %g %g | %g %g %g %g | %g %g %g %g]: "
+			    "nothing handed",
+			    P[0][0], P[0][1], P[0][2], P[0][3], P[1][0], P[1][1], P[1][2], P[1][3], P[2][0], P[2][1], P[2][2], P[2][3],
+			    P[3][0], P[3][1], P[3][2], P[3][3]);
+		}
+		return SkipOther(history);
+	}
+	if (!g.saidRange && (in.vRange[0] != 0.f || in.vRange[1] != 1.f)) {
+		g.saidRange = true;
+		Say("the game's depth range is %g-%g (not used: the depth is read through mProjection)", in.vRange[0], in.vRange[1]);
+	}
+	if (in.bounds[0] > in.bounds[1] || in.bounds[2] > in.bounds[3]) {
+		if (!g.saidFlip) {
+			g.saidFlip = true;
+			Say("eye %d's bounds are flipped (u %.4f-%.4f v %.4f-%.4f): nothing handed", eye, in.bounds[0], in.bounds[1],
+			    in.bounds[2], in.bounds[3]);
+		}
+		return SkipOther(history);
+	}
+	if (in.width <= 0 || in.height <= 0)
+		return SkipOther(history);
+	if (eye == 0 || !g.depth[0].texture) {
+		if (!EnsureOutputs(uint32_t(in.width), uint32_t(in.height)))
+			return false;
+	} else if (uint32_t(in.width) != g.width || uint32_t(in.height) != g.height) {
+		// the block holds one size for both eyes and the layer refuses another: this eye goes without
+		++g.total.sizeSkips;
+		++g.wSize;
+		history.valid = false;
+		if (!g.saidSize) {
+			g.saidSize = true;
+			Say("eye 1 is %dx%d and eye 0 %ux%u: the layer takes one size, so eye 1 goes without the game's data", in.width,
+			    in.height, g.width, g.height);
+		}
+		return false;
+	}
+	SourceView* source = Source(in.depth);
+	if (!source)
+		return SkipOther(history);
+
+	// a cut: zero motion this frame
+	bool cut = !history.valid || (in.submitFlags & 0x20) != 0 || in.nowMs - history.atMs > kGapMs;
+	float r[3][3] = { { 1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 } }, t[3] = { 0, 0, 0 };
+	if (!cut) {
+		Relative(in.pose, history.pose, r, t);
+		static const float identity[3][3] = { { 1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 } };
+		const float moved = std::sqrt(t[0] * t[0] + t[1] * t[1] + t[2] * t[2]);
+		if (moved > kJumpMetres || AngleDegrees(r, identity) > kJumpDegrees)
+			cut = true;
+	}
+	if (in.hasRenderRotation) { // diagnostics: the game's render pose against the OpenXR view used here
+		float view[3][3];
+		QuatToMatrix(in.pose.orientation, view);
+		const float gap = AngleDegrees(view, in.renderRotation);
+		if (gap > g.wGapMax)
+			g.wGapMax = gap;
+	}
+
+	Constants c{};
+	const float bw = in.bounds[1] - in.bounds[0], bh = in.bounds[3] - in.bounds[2];
+	c.origin[0] = int32_t(in.bounds[0] * float(source->width));
+	c.origin[1] = int32_t(in.bounds[2] * float(source->height));
+	c.last[0] = int32_t(source->width) - 1;
+	c.last[1] = int32_t(source->height) - 1;
+	c.size[0] = float(g.width);
+	c.size[1] = float(g.height);
+	c.stepSize[0] = bw * float(source->width) / float(g.width);
+	c.stepSize[1] = bh * float(source->height) / float(g.height);
+	for (int i = 0; i < 4; ++i) {
+		c.tanNow[i] = now.tangents[i];
+		c.tanThen[i] = cut ? now.tangents[i] : history.tangents[i];
+	}
+	float* rows[3] = { c.row0, c.row1, c.row2 };
+	for (int i = 0; i < 3; ++i) {
+		rows[i][0] = r[i][0];
+		rows[i][1] = r[i][1];
+		rows[i][2] = r[i][2];
+		rows[i][3] = t[i];
+	}
+	c.k = now.k;
+	c.m22 = now.m22;
+	c.nearRef = now.nearRef;
+	c.mode = (cut ? 1u : 0u) | (source->multisampled ? 2u : 0u);
+
+	// this frame is the next one's previous, handed or not: the layer's history follows the game's frames
+	history.valid = true;
+	history.pose = in.pose;
+	for (int i = 0; i < 4; ++i)
+		history.tangents[i] = now.tangents[i];
+	history.atMs = in.nowMs;
+
+	UINT depthKey = 0, motionKey = 0;
+	if (!Take(g.depth[eye].mutex, depthKey)) {
+		++g.total.busy;
+		++g.wBusy;
+		return false;
+	}
+	if (!Take(g.motion[eye].mutex, motionKey)) {
+		g.depth[eye].mutex->ReleaseSync(depthKey); // as it was
+		++g.total.busy;
+		++g.wBusy;
+		return false;
+	}
+	Dispatch(eye, *source, c);
+	g.depth[eye].mutex->ReleaseSync(1);
+	g.motion[eye].mutex->ReleaseSync(1);
+	// the pass submitted now: a reader on another device (the bridge host's layer, SSW's route) waits on the GPU for it,
+	// and nothing else may submit the game's context before that reader is answered (desk test, 2026-11-20: a second
+	// process's read waited for ever without it). rever_vk_depth's producer flushes after its keys likewise.
+	g.context->Flush();
+	g.block->eyes[eye].phase = 0;
+	MemoryBarrier();
+	InterlockedIncrement(&g.block->eyes[eye].seq);
+
+	++g.total.produced;
+	++g.wProduced;
+	if (cut) {
+		++g.total.resets;
+		++g.wResets;
+	}
+	if (!g.saidFirst[eye]) {
+		g.saidFirst[eye] = true;
+		char view[160] = "";
+		if (in.hasViewTangents)
+			snprintf(view, sizeof(view), " (the OpenXR view's: l %.4f r %.4f u %.4f d %.4f)", in.viewTangents[0], in.viewTangents[1],
+			    in.viewTangents[2], in.viewTangents[3]);
+		Say("eye %d first handed to Rever's layer: %ux%u from the game's depth %ux%u at %d,%d (%.3f x %.3f depth pixels a pixel); "
+		    "inverted depth, near_ref %.5f m (k %.6f, P22 %.6f); projection tangents l %.4f r %.4f u %.4f d %.4f%s",
+		    eye, g.width, g.height, source->width, source->height, c.origin[0], c.origin[1], c.stepSize[0], c.stepSize[1],
+		    now.nearRef, now.k, now.m22, now.tangents[0], now.tangents[1], now.tangents[2], now.tangents[3], view);
+	}
+	return true;
+}
+
+Stats CurrentStats()
+{
+	Stats s = g.total;
+	s.width = g.width;
+	s.height = g.height;
+	s.generation = g.generation;
+	s.broken = g.broken;
+	return s;
+}
+
+void TestReset()
+{
+	DropDevice();
+	if (g.block)
+		UnmapViewOfFile(g.block);
+	if (g.blockMap)
+		CloseHandle(g.blockMap);
+	g = State{};
+}
