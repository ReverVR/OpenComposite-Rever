+struct Gpu {
+	ID3D11Device* device = nullptr;
+	ID3D11Device1* device1 = nullptr;
+	ID3D11DeviceContext* ctx = nullptr;
+	ID3D11VertexShader* vs = nullptr;
+	ID3D11PixelShader* ps = nullptr;
+	ID3D11Buffer* cb = nullptr;
+	ID3D11DepthStencilState* always = nullptr;
+	ID3D11RasterizerState* raster = nullptr;
+};
+
+ID3DBlob* Compile(const char* source, const char* entry, const char* target)
+{
+	ID3DBlob* code = nullptr;
+	ID3DBlob* errors = nullptr;
+	if (FAILED(D3DCompile(source, std::strlen(source), "test", nullptr, nullptr, entry, target, 0, 0, &code, &errors))) {
+		std::printf("shader %s: %s\n", entry, errors ? (const char*)errors->GetBufferPointer() : "?");
+		std::exit(2);
+	}
+	SafeRelease(errors);
+	return code;
+}
+
+bool MakeGpu(Gpu& g)
+{
+	const D3D_FEATURE_LEVEL levels[] = { D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0 };
+	if (FAILED(D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0, levels, 2, D3D11_SDK_VERSION, &g.device, nullptr, &g.ctx)))
+		return false;
+	g.device->QueryInterface(__uuidof(ID3D11Device1), reinterpret_cast<void**>(&g.device1));
+	ID3DBlob* vs = Compile(kSceneShader, "VS", "vs_5_0");
+	ID3DBlob* ps = Compile(kSceneShader, "PS", "ps_5_0");
+	g.device->CreateVertexShader(vs->GetBufferPointer(), vs->GetBufferSize(), nullptr, &g.vs);
+	g.device->CreatePixelShader(ps->GetBufferPointer(), ps->GetBufferSize(), nullptr, &g.ps);
+	SafeRelease(vs);
+	SafeRelease(ps);
+	D3D11_BUFFER_DESC cb{};
+	cb.ByteWidth = sizeof(SceneConstants);
+	cb.Usage = D3D11_USAGE_DEFAULT;
+	cb.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+	g.device->CreateBuffer(&cb, nullptr, &g.cb);
+	D3D11_DEPTH_STENCIL_DESC ds{};
+	ds.DepthEnable = TRUE;
+	ds.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ALL;
+	ds.DepthFunc = D3D11_COMPARISON_ALWAYS;
+	g.device->CreateDepthStencilState(&ds, &g.always);
+	D3D11_RASTERIZER_DESC rd{};
+	rd.FillMode = D3D11_FILL_SOLID;
+	rd.CullMode = D3D11_CULL_NONE;
+	rd.DepthClipEnable = FALSE;
+	g.device->CreateRasterizerState(&rd, &g.raster);
+	return g.device1 && g.vs && g.ps && g.cb && g.always && g.raster;
+}
+
+struct DepthTarget {
+	ID3D11Texture2D* texture = nullptr;
+	ID3D11DepthStencilView* dsv = nullptr;
+	uint32_t width = 0, height = 0;
+};
+
+DepthTarget MakeDepth(Gpu& g, uint32_t w, uint32_t h, uint32_t samples)
+{
+	DepthTarget t;
+	t.width = w;
+	t.height = h;
+	D3D11_TEXTURE2D_DESC d{};
+	d.Width = w;
+	d.Height = h;
+	d.MipLevels = d.ArraySize = 1;
+	d.Format = DXGI_FORMAT_R24G8_TYPELESS; // Alyx's: DXGI 44, bind 0x48
+	d.SampleDesc.Count = samples;
+	d.Usage = D3D11_USAGE_DEFAULT;
+	d.BindFlags = D3D11_BIND_DEPTH_STENCIL | D3D11_BIND_SHADER_RESOURCE;
+	g.device->CreateTexture2D(&d, nullptr, &t.texture);
+	D3D11_DEPTH_STENCIL_VIEW_DESC v{};
+	v.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+	v.ViewDimension = samples > 1 ? D3D11_DSV_DIMENSION_TEXTURE2DMS : D3D11_DSV_DIMENSION_TEXTURE2D;
+	g.device->CreateDepthStencilView(t.texture, &v, &t.dsv);
+	return t;
+}
+
+struct Layout {
+	uint32_t texW, texH;
+	float bounds[2][4]; // per eye: uMin, uMax, vMin, vMax (as Alyx computes them: render size / texture size)
+	int32_t width, height; // the eye as OpenComposite's Compositor::CalculateViewport makes it
+	int32_t origin[2][2];
+};
+
+Layout MakeLayout(uint32_t renderSize, uint32_t texW, uint32_t texH)
+{
+	Layout l{};
+	l.texW = texW;
+	l.texH = texH;
+	const float a = float(renderSize) / float(texW), b = float(2 * renderSize) / float(texW), v = float(renderSize) / float(texH);
+	const float bounds[2][4] = { { 0.f, a, 0.f, v }, { a, b, 0.f, v } };
+	std::memcpy(l.bounds, bounds, sizeof(bounds));
+	// Compositor::CalculateViewport's own arithmetic
+	l.width = (int)((a - 0.f) * (float)texW);
+	l.height = (int)((v - 0.f) * (float)texH);
+	for (int e = 0; e < 2; ++e) {
+		l.origin[e][0] = (int)(l.bounds[e][0] * (float)texW);
+		l.origin[e][1] = (int)(l.bounds[e][2] * (float)texH);
+	}
+	return l;
+}
+
+void DrawDepth(Gpu& g, DepthTarget& t, const Layout& l, const Eye eyes[2], bool clear = true)
+{
+	if (clear)
+		g.ctx->ClearDepthStencilView(t.dsv, D3D11_CLEAR_DEPTH | D3D11_CLEAR_STENCIL, 1.0f, 0);
+	g.ctx->OMSetRenderTargets(0, nullptr, t.dsv);
+	g.ctx->OMSetDepthStencilState(g.always, 0);
+	g.ctx->RSSetState(g.raster);
+	g.ctx->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+	g.ctx->IASetInputLayout(nullptr);
+	g.ctx->VSSetShader(g.vs, nullptr, 0);
+	g.ctx->PSSetShader(g.ps, nullptr, 0);
+	g.ctx->PSSetConstantBuffers(0, 1, &g.cb);
+	for (int e = 0; e < 2; ++e) {
+		SceneConstants c{};
+		c.rect[0] = float(l.origin[e][0]);
+		c.rect[1] = float(l.origin[e][1]);
+		c.rect[2] = float(l.width);
+		c.rect[3] = float(l.height);
+		for (int i = 0; i < 4; ++i)
+			c.tangents[i] = float(eyes[e].tangents[i]);
+		float* rows[3] = { c.rot0, c.rot1, c.rot2 };
+		for (int i = 0; i < 3; ++i)
+			for (int j = 0; j < 3; ++j)
+				rows[i][j] = float(eyes[e].rotation[i][j]);
+		for (int i = 0; i < 3; ++i)
+			c.position[i] = float(eyes[e].position[i]);
+		c.depthMap[0] = kP22;
+		c.depthMap[1] = kP23;
+		g.ctx->UpdateSubresource(g.cb, 0, nullptr, &c, 0, 0);
+		D3D11_VIEWPORT vp{ float(l.origin[e][0]), float(l.origin[e][1]), float(l.width), float(l.height), 0.f, 1.f };
+		g.ctx->RSSetViewports(1, &vp);
+		g.ctx->Draw(3, 0);
+	}
+	g.ctx->OMSetRenderTargets(0, nullptr, nullptr);
+}
+
+EyeInput Input(const DepthTarget& t, const Layout& l, const Eye& eye, int e, uint64_t nowMs, uint32_t flags = 0x218)
+{
+	EyeInput in;
+	in.depth = t.texture;
+	Projection(eye, in.projection);
+	std::memcpy(in.bounds, l.bounds[e], sizeof(in.bounds));
+	// the pose as OpenXR hands it: a quaternion of the rotation
+	const double(*m)[3] = eye.rotation;
+	const double trace = m[0][0] + m[1][1] + m[2][2];
+	double q[4];
+	if (trace > 0) {
+		const double s = std::sqrt(trace + 1.0) * 2;
+		q[3] = 0.25 * s;
+		q[0] = (m[2][1] - m[1][2]) / s;
+		q[1] = (m[0][2] - m[2][0]) / s;
+		q[2] = (m[1][0] - m[0][1]) / s;
+	} else {
+		q[0] = 0, q[1] = 0, q[2] = 0, q[3] = 1; // never in this test (small turns)
+	}
+	for (int i = 0; i < 4; ++i)
+		in.pose.orientation[i] = float(q[i]);
+	for (int i = 0; i < 3; ++i)
+		in.pose.position[i] = float(eye.position[i]);
+	in.width = l.width;
+	in.height = l.height;
+	in.submitFlags = flags;
+	in.nowMs = nowMs;
+	return in;
+}
