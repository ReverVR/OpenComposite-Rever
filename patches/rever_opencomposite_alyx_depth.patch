+// --- rever_xr_nr's SrTakeInputs (layer.cpp 4138-4206), its logic copied ---------------------------------------------
+struct SrInputsBlock {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t pid;
+	volatile LONG generation;
+	uint32_t width, height;
+	uint32_t flags;
+	uint32_t reserved;
+	struct EyeBlock {
+		volatile LONG seq;
+		uint32_t phase;
+		uint32_t reserved[2];
+	} eyes[2];
+};
+constexpr uint32_t kSrInputsMagic = 0x49535652;
+
+enum TakeResult { kTaken, kNoBlock, kBadBlock, kSizeRefused, kOpenFailed, kNothingNew, kBusy };
+
+struct LayerReader {
+	ID3D11Device1* device1 = nullptr;
+	ID3D11DeviceContext* ctx = nullptr;
+	HANDLE map = nullptr;
+	const SrInputsBlock* block = nullptr;
+	LONG generation = 0;
+	ID3D11Texture2D* depth[2] = {};
+	ID3D11Texture2D* motion[2] = {};
+	IDXGIKeyedMutex* depthMutex[2] = {};
+	IDXGIKeyedMutex* motionMutex[2] = {};
+	LONG seq[2] = {};
+	bool inverted = false;
+	uint32_t phase = 0;
+	HRESULT lastAcquire = S_OK; // diagnostics: the last AcquireSync's answer
+
+	void CloseTextures()
+	{
+		for (int e = 0; e < 2; ++e) {
+			SafeRelease(depthMutex[e]);
+			SafeRelease(motionMutex[e]);
+			SafeRelease(depth[e]);
+			SafeRelease(motion[e]);
+			seq[e] = 0;
+		}
+	}
+	void Close()
+	{
+		CloseTextures();
+		if (block)
+			UnmapViewOfFile(block);
+		if (map)
+			CloseHandle(map);
+		block = nullptr;
+		map = nullptr;
+		generation = 0;
+	}
+
+	static bool ReadBack(ID3D11Device* device, ID3D11DeviceContext* ctx, ID3D11Texture2D* texture, std::vector<float>& out, int channels)
+	{
+		D3D11_TEXTURE2D_DESC d{};
+		texture->GetDesc(&d);
+		d.BindFlags = 0;
+		d.MiscFlags = 0;
+		d.Usage = D3D11_USAGE_STAGING;
+		d.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+		ID3D11Texture2D* staging = nullptr;
+		if (FAILED(device->CreateTexture2D(&d, nullptr, &staging)))
+			return false;
+		ctx->CopyResource(staging, texture);
+		D3D11_MAPPED_SUBRESOURCE m{};
+		if (FAILED(ctx->Map(staging, 0, D3D11_MAP_READ, 0, &m))) {
+			staging->Release();
+			return false;
+		}
+		out.assign(size_t(d.Width) * d.Height * channels, 0.f);
+		for (uint32_t y = 0; y < d.Height; ++y) {
+			const uint8_t* row = static_cast<const uint8_t*>(m.pData) + size_t(y) * m.RowPitch;
+			for (uint32_t x = 0; x < d.Width; ++x) {
+				if (channels == 1) {
+					std::memcpy(&out[size_t(y) * d.Width + x], row + x * 4, 4);
+				} else {
+					uint16_t h[2];
+					std::memcpy(h, row + x * 4, 4);
+					for (int c = 0; c < 2; ++c) {
+						const uint32_t s = (h[c] >> 15) & 1, ex = (h[c] >> 10) & 31, ma = h[c] & 1023;
+						float v = ex == 0 ? std::ldexp(float(ma), -24) : ex == 31 ? NAN : std::ldexp(float(ma | 1024), int(ex) - 25);
+						out[(size_t(y) * d.Width + x) * 2 + c] = s ? -v : v;
+					}
+				}
+			}
+		}
+		ctx->Unmap(staging, 0);
+		staging->Release();
+		return true;
+	}
+
+	TakeResult Take(uint32_t eye, uint32_t w, uint32_t h, DWORD waitMs, std::vector<float>* depthOut, std::vector<float>* motionOut)
+	{
+		if (!block) {
+			map = OpenFileMappingW(FILE_MAP_READ, FALSE, kBlockName); // the layer: L"Local\\ReverVR_DLSS_SR_Inputs"
+			if (!map)
+				return kNoBlock;
+			block = static_cast<const SrInputsBlock*>(MapViewOfFile(map, FILE_MAP_READ, 0, 0, sizeof(SrInputsBlock)));
+			if (!block || block->magic != kSrInputsMagic || block->version != 1) {
+				if (block)
+					UnmapViewOfFile(block);
+				CloseHandle(map);
+				block = nullptr;
+				map = nullptr;
+				return kBadBlock;
+			}
+		}
+		if (block->width != w || block->height != h)
+			return kSizeRefused;
+		const LONG gen = block->generation;
+		if (gen != generation) {
+			CloseTextures();
+			generation = gen;
+			for (uint32_t e = 0; e < 2; ++e)
+				for (int kind = 0; kind < 2; ++kind) {
+					wchar_t name[128]; // the layer: L"Local\\ReverVR_SR_%u_%ld_%u%c"
+					swprintf_s(name, L"%s%u_%ld_%u%c", kTexturePrefix, block->pid, gen, e, kind ? L'M' : L'D');
+					ID3D11Texture2D*& texture = kind ? motion[e] : depth[e];
+					IDXGIKeyedMutex*& mutex = kind ? motionMutex[e] : depthMutex[e];
+					if (FAILED(device1->OpenSharedResourceByName(name, DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE,
+					        __uuidof(ID3D11Texture2D), reinterpret_cast<void**>(&texture)))
+					    || FAILED(texture->QueryInterface(__uuidof(IDXGIKeyedMutex), reinterpret_cast<void**>(&mutex)))) {
+						CloseTextures();
+						return kOpenFailed;
+					}
+				}
+		}
+		const LONG s = block->eyes[eye].seq;
+		if (s == seq[eye])
+			return kNothingNew;
+		lastAcquire = depthMutex[eye]->AcquireSync(1, waitMs);
+		if (lastAcquire != S_OK)
+			return kBusy;
+		lastAcquire = motionMutex[eye]->AcquireSync(1, waitMs);
+		if (lastAcquire != S_OK) {
+			depthMutex[eye]->ReleaseSync(1);
+			return kBusy;
+		}
+		seq[eye] = s;
+		inverted = (block->flags & 1) != 0;
+		phase = block->eyes[eye].phase;
+		ID3D11Device* device = nullptr;
+		device1->QueryInterface(__uuidof(ID3D11Device), reinterpret_cast<void**>(&device));
+		if (depthOut)
+			ReadBack(device, ctx, depth[eye], *depthOut, 1);
+		if (motionOut)
+			ReadBack(device, ctx, motion[eye], *motionOut, 2);
+		device->Release();
+		depthMutex[eye]->ReleaseSync(0); // SrGiveBack
+		motionMutex[eye]->ReleaseSync(0);
+		return kTaken;
+	}
+};
+
+// --- the CPU's own answer ----------------------------------------------------------------------------------------------
+struct Expected {
+	std::vector<float> depth; // inverted, 0 for the sky
+	std::vector<float> motion; // x, y
+	std::vector<uint8_t> valid; // 1: compare (not on a silhouette, the point in the previous frame's view)
+	std::vector<uint8_t> sky;
+};
+
+Expected Reproject(const Eye& now, const Eye& before, const float Pbefore[4][4], int w, int h, bool withMotion)
+{
+	Expected x;
+	x.depth.assign(size_t(w) * h, 0.f);
+	x.motion.assign(size_t(w) * h * 2, 0.f);
+	x.valid.assign(size_t(w) * h, 0);
+	x.sky.assign(size_t(w) * h, 0);
+	std::vector<int> ids(size_t(w) * h, 0);
+	std::vector<double> dist(size_t(w) * h, -1);
+	for (int y = 0; y < h; ++y)
+		for (int xx = 0; xx < w; ++xx) {
+			const double u = (xx + 0.5) / w, v = (y + 0.5) / h;
+			const double vd[3] = { now.tangents[0] + (now.tangents[1] - now.tangents[0]) * u,
+				now.tangents[2] + (now.tangents[3] - now.tangents[2]) * v, -1.0 };
+			double wd[3];
+			for (int i = 0; i < 3; ++i)
+				wd[i] = now.rotation[i][0] * vd[0] + now.rotation[i][1] * vd[1] + now.rotation[i][2] * vd[2];
+			int id = 0;
+			const double s = Hit(now.position, wd, id);
+			ids[size_t(y) * w + xx] = id;
+			dist[size_t(y) * w + xx] = s;
+			x.depth[size_t(y) * w + xx] = s > 0 ? float(kNearRef / s) : 0.f;
+			x.sky[size_t(y) * w + xx] = s > 0 ? 0 : 1;
+			// where it was: the world point (or the direction, for the sky) through the previous eye's view and 4x4 projection
+			double rel[3];
+			if (s > 0) {
+				const double p[3] = { now.position[0] + s * wd[0] - before.position[0], now.position[1] + s * wd[1] - before.position[1],
+					now.position[2] + s * wd[2] - before.position[2] };
+				for (int i = 0; i < 3; ++i)
+					rel[i] = before.rotation[0][i] * p[0] + before.rotation[1][i] * p[1] + before.rotation[2][i] * p[2];
+			} else {
+				for (int i = 0; i < 3; ++i)
+					rel[i] = before.rotation[0][i] * wd[0] + before.rotation[1][i] * wd[1] + before.rotation[2][i] * wd[2];
+			}
+			const double clip[4] = { Pbefore[0][0] * rel[0] + Pbefore[0][1] * rel[1] + Pbefore[0][2] * rel[2],
+				Pbefore[1][0] * rel[0] + Pbefore[1][1] * rel[1] + Pbefore[1][2] * rel[2], 0.0, -rel[2] };
+			if (clip[3] <= 1e-6)
+				continue;
+			const double ub = clip[0] / clip[3] * 0.5 + 0.5, vb = 0.5 - clip[1] / clip[3] * 0.5;
+			if (withMotion) {
+				x.motion[(size_t(y) * w + xx) * 2] = float((ub - u) * w);
+				x.motion[(size_t(y) * w + xx) * 2 + 1] = float((vb - v) * h);
+			}
+			x.valid[size_t(y) * w + xx] = 1;
+		}
+	// not on a silhouette: the same object all around
+	for (int y = 0; y < h; ++y)
+		for (int xx = 0; xx < w; ++xx) {
+			if (y == 0 || xx == 0 || y == h - 1 || xx == w - 1) {
+				x.valid[size_t(y) * w + xx] = 0;
+				continue;
+			}
+			const int id = ids[size_t(y) * w + xx];
+			for (int dy = -1; dy <= 1; ++dy)
+				for (int dx = -1; dx <= 1; ++dx)
+					if (ids[size_t(y + dy) * w + xx + dx] != id)
+						x.valid[size_t(y) * w + xx] = 0;
+		}
+	return x;
+}
+
+struct Compare {
+	double depthMaxRel = 0, motionMax = 0, motionMean = 0, skyMotionMax = 0;
+	uint64_t compared = 0, bad = 0, skyPixels = 0, skyNonZeroDepth = 0;
+};
+
+Compare CompareEye(const Expected& x, const std::vector<float>& depth, const std::vector<float>& motion, bool motionZero)
+{
+	Compare c;
+	double sum = 0;
+	for (size_t i = 0; i < x.valid.size(); ++i) {
+		if (x.sky[i]) {
+			++c.skyPixels;
+			if (depth[i] != 0.f)
+				++c.skyNonZeroDepth;
+		}
+		if (!x.valid[i])
+			continue;
+		++c.compared;
+		const double ed = x.depth[i], gd = depth[i];
+		const double rel = std::fabs(gd - ed) / (ed > 1e-6 ? ed : 1.0);
+		if (rel > c.depthMaxRel)
+			c.depthMaxRel = rel;
+		const double ex = motionZero ? 0.0 : x.motion[i * 2], ey = motionZero ? 0.0 : x.motion[i * 2 + 1];
+		const double err = std::hypot(motion[i * 2] - ex, motion[i * 2 + 1] - ey);
+		const double tolerance = 0.1 + 0.002 * std::hypot(ex, ey);
+		if (err > tolerance || rel > 1e-4 || !std::isfinite(err))
+			++c.bad;
+		if (err > c.motionMax)
+			c.motionMax = err;
+		if (x.sky[i] && err > c.skyMotionMax)
+			c.skyMotionMax = err;
+		sum += err;
+	}
+	c.motionMean = c.compared ? sum / double(c.compared) : 0;
+	return c;
+}
+
+double MaxAbs(const std::vector<float>& v)
+{
+	double m = 0;
+	for (float f : v)
+		m = std::fabs(f) > m ? std::fabs(f) : m;
+	return m;
+}
+
+double MeanAbsMotion(const std::vector<float>& v)
+{
+	double s = 0;
+	for (size_t i = 0; i + 1 < v.size(); i += 2)
+		s += std::hypot(v[i], v[i + 1]);
+	return v.empty() ? 0 : s / double(v.size() / 2);
+}
+
+double Sum(const std::vector<float>& v)
+{
+	double s = 0;
+	for (float f : v)
+		s += f;
+	return s;
+}
+
+// --- a second process: the bridge host's layer, its own device, alive across frames ----------------------------------
+// As the real host it is up before the game's frames: it says it is ready, then takes each frame as the producer hands it
+// (SrTakeInputs' logic, LayerReader, the layer's own 2 ms wait) and gives it back with key 0, frame after frame. One line
+// per eye and frame. (2026-11-20: a reader process started only after the frame was handed, seconds later - a new exe
+// is scanned before it runs here - found the keys back at 0 in some runs and not in others; the host never works so.)
+const wchar_t kReadyEvent[] = L"Local\\ReverDeskTestReaderReady";
+const wchar_t kTakenEvent[] = L"Local\\ReverDeskTestReaderTaken";
+
+int ReaderProcess(uint32_t w, uint32_t h, int frames, unsigned long parent)
+{
+	ID3D11Device* device = nullptr;
+	ID3D11DeviceContext* ctx = nullptr;
+	const D3D_FEATURE_LEVEL level = D3D_FEATURE_LEVEL_11_0;
+	if (FAILED(D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0, &level, 1, D3D11_SDK_VERSION, &device, nullptr, &ctx)))
+		return 3;
+	wchar_t name[96];
+	swprintf_s(name, L"%s_%lu", kReadyEvent, parent);
+	HANDLE ready = OpenEventW(EVENT_MODIFY_STATE, FALSE, name);
+	swprintf_s(name, L"%s_%lu", kTakenEvent, parent);
+	HANDLE taken = OpenEventW(EVENT_MODIFY_STATE, FALSE, name);
+	if (!ready || !taken)
+		return 6;
+	LayerReader reader;
+	device->QueryInterface(__uuidof(ID3D11Device1), reinterpret_cast<void**>(&reader.device1));
+	reader.ctx = ctx;
+	SetEvent(ready);
+	int result = 0;
+	for (int frame = 0; frame < frames && !result; ++frame) {
+		for (uint32_t e = 0; e < 2; ++e) {
+			std::vector<float> depth, motion;
+			TakeResult r = kNoBlock;
+			const ULONGLONG until = GetTickCount64() + 20000;
+			while (r != kTaken && GetTickCount64() < until) {
+				r = reader.Take(e, w, h, 2, &depth, &motion);
+				if (r != kTaken)
+					Sleep(1);
+			}
+			if (r != kTaken) {
+				std::printf("READERFAIL frame %d eye %u result %d last AcquireSync 0x%08lx\n", frame, e, int(r),
+				    (unsigned long)reader.lastAcquire);
+				result = 4;
+				break;
+			}
+			std::printf("READER frame %d eye %u depth %.6f motion %.6f\n", frame, e, Sum(depth), MeanAbsMotion(motion));
+		}
+		SetEvent(taken);
+	}
+	std::printf("READER pid %lu done\n", GetCurrentProcessId());
+	reader.Close();
+	SafeRelease(reader.device1);
+	CloseHandle(ready);
+	CloseHandle(taken);
+	ctx->Release();
+	device->Release();
+	return result;
+}
+
+struct ReaderChild {
+	HANDLE process = nullptr;
+	HANDLE ready = nullptr;
+	HANDLE taken = nullptr;
+	std::wstring file;
+};
+
+bool StartReader(ReaderChild& c, uint32_t w, uint32_t h, int frames)
+{
+	wchar_t name[96];
+	swprintf_s(name, L"%s_%lu", kReadyEvent, GetCurrentProcessId());
+	c.ready = CreateEventW(nullptr, FALSE, FALSE, name);
+	swprintf_s(name, L"%s_%lu", kTakenEvent, GetCurrentProcessId());
+	c.taken = CreateEventW(nullptr, FALSE, FALSE, name);
+	wchar_t exe[MAX_PATH];
+	GetModuleFileNameW(nullptr, exe, MAX_PATH);
+	c.file = exe;
+	c.file = c.file.substr(0, c.file.find_last_of(L"\\/") + 1) + L"reader_answer.txt";
+	DeleteFileW(c.file.c_str());
+	wchar_t command[2 * MAX_PATH + 96];
+	swprintf_s(command, L"\"%s\" --reader %u %u \"%s\" %d %lu", exe, w, h, c.file.c_str(), frames, GetCurrentProcessId());
+	STARTUPINFOW si{ sizeof(si) };
+	PROCESS_INFORMATION pi{};
+	if (!c.ready || !c.taken || !CreateProcessW(nullptr, command, nullptr, nullptr, FALSE, CREATE_NO_WINDOW, nullptr, nullptr, &si, &pi))
+		return false;
+	CloseHandle(pi.hThread);
+	c.process = pi.hProcess;
+	return true;
+}
+
+// true when the event came before the reader process ended (or the time ran out)
+bool WaitFor(const ReaderChild& c, HANDLE event, DWORD ms)
+{
+	HANDLE both[2] = { event, c.process };
+	return WaitForMultipleObjects(2, both, FALSE, ms) == WAIT_OBJECT_0;
+}
+
+std::string FinishReader(ReaderChild& c, DWORD& exitCode)
+{
+	exitCode = 999;
+	if (c.process) {
+		WaitForSingleObject(c.process, 30000);
+		GetExitCodeProcess(c.process, &exitCode);
+		CloseHandle(c.process);
+	}
+	if (c.ready)
+		CloseHandle(c.ready);
+	if (c.taken)
+		CloseHandle(c.taken);
+	c = ReaderChild{ nullptr, nullptr, nullptr, c.file };
+	std::string out;
+	FILE* f = nullptr;
+	if (_wfopen_s(&f, c.file.c_str(), L"rb") == 0 && f) {
+		char buffer[512];
+		size_t got = 0;
+		while ((got = std::fread(buffer, 1, sizeof(buffer), f)) > 0)
+			out.append(buffer, got);
+		std::fclose(f);
+	}
+	return out;
+}
+
+std::vector<std::string> g_logLines;
+void Sink(const char* line)
+{
+	g_logLines.push_back(line);
+	std::printf("  log> %s\n", line);
+}
+
+bool Logged(const char* part)
+{
+	for (const std::string& line : g_logLines)
+		if (line.find(part) != std::string::npos)
+			return true;
+	return false;
+}
