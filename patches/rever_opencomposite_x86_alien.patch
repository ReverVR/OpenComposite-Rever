+// Rever VR: which eye's last bounds left nothing to show, and a log line when an eye's bounds change (the first 200)
+static bool reverEyeBoundsEmpty[2] = { false, false };
+
+static void ReverNoteEyeBounds(vr::EVREye eye, const vr::VRTextureBounds_t* bounds, const XrRect2Di& rect)
+{
+	static vr::VRTextureBounds_t last[2] = { { -1, -1, -1, -1 }, { -1, -1, -1, -1 } };
+	static int logged = 0;
+	int index = eye == vr::Eye_Right ? 1 : 0;
+	reverEyeBoundsEmpty[index] = rect.extent.width <= 0 || rect.extent.height <= 0;
+	vr::VRTextureBounds_t now = bounds ? *bounds : vr::VRTextureBounds_t{ 0, 0, 1, 1 };
+	if (std::memcmp(&now, &last[index], sizeof(now)) == 0 || logged >= 200)
+		return;
+	last[index] = now;
+	++logged;
+	OOVR_LOGF("Rever VR: eye %d bounds u %f..%f v %f..%f -> rect %d,%d %dx%d%s", index, now.uMin, now.uMax, now.vMin,
+	    now.vMax, rect.offset.x, rect.offset.y, rect.extent.width, rect.extent.height,
+	    reverEyeBoundsEmpty[index] ? " (no scene)" : "");
+}
