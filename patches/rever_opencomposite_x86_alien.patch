+// Rever VR: moves a screen placed straight ahead of the seated origin to the same distance ahead of the headset, at
+// eye height and facing the way it looks, held still in the world from then on; the origin itself is at the user's
+// feet. Only with the headset tracked: Alien Isolation's intro places it as the session starts, when the head was
+// still reported at the origin and the screen went to the feet again (2026-10-09).
+static bool ReverAnchorToHead(MfMatrix4f& transform, const std::string& key)
+{
+	XrSpaceLocation head{ XR_TYPE_SPACE_LOCATION };
+	XrSpace space = xr_space_from_ref_space_type(GetUnsafeBaseSystem()->currentSpace);
+	const XrSpaceLocationFlags tracked = XR_SPACE_LOCATION_POSITION_VALID_BIT | XR_SPACE_LOCATION_ORIENTATION_VALID_BIT
+	    | XR_SPACE_LOCATION_POSITION_TRACKED_BIT | XR_SPACE_LOCATION_ORIENTATION_TRACKED_BIT;
+	if (!XR_SUCCEEDED(xrLocateSpace(xr_gbl->viewSpace, space, xr_gbl->GetBestTime(), &head)) || (head.locationFlags & tracked) != tracked)
+		return false;
+	glm::vec3 headPosition = X2G_v3f(head.pose.position);
+	if (glm::length(headPosition) < 0.05f)
+		return false;
+
+	glm::vec3 forward = X2G_quat(head.pose.orientation) * glm::vec3(0.0f, 0.0f, -1.0f);
+	float yaw = std::atan2(-forward.x, -forward.z);
+	glm::mat3 turn = glm::mat3(glm::rotate(glm::mat4(1.0f), yaw, glm::vec3(0.0f, 1.0f, 0.0f)));
+	// transform[row][column] holds OpenVR's rows; glm's matrices are column-major
+	glm::mat3 rotation;
+	for (int row = 0; row < 3; row++)
+		for (int column = 0; column < 3; column++)
+			rotation[column][row] = transform[row][column];
+	rotation = turn * rotation;
+	glm::vec3 position = headPosition + turn * glm::vec3(0.0f, 0.0f, transform[2][3]);
+	for (int row = 0; row < 3; row++) {
+		for (int column = 0; column < 3; column++)
+			transform[row][column] = rotation[column][row];
+		transform[row][3] = position[row];
+	}
+	OOVR_LOGF("Rever VR: overlay '%s' anchored to the headset at %f %f %f", key.c_str(), position.x, position.y, position.z);
+	return true;
+}
